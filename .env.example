# ArchitectIQ Environment Configuration

# LLM Provider: "groq" (free cloud API) or "ollama" (local)
LLM_PROVIDER=groq

# Groq — free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama — only needed if LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Paths
CONTENT_DIR=./content
DB_PATH=./data/architectiq.db
TTS_MODEL=en_US-lessac-medium
TTS_CACHE_DIR=./data/tts_cache

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Frontend → Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
