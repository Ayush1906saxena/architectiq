# ArchitectIQ environment. Copy to .env (never commit .env). Every value is optional.

# LLM provider: "groq" (free cloud API) or "ollama" (local).
# With LLM_PROVIDER=groq but no GROQ_API_KEY, the API falls back to Ollama on its own.
LLM_PROVIDER=ollama

# Groq: free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (docker compose runs one and pulls the model on first start)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Paths (for running the API outside Docker)
CONTENT_DIR=./content
DB_PATH=./data/architectiq.db
TTS_CACHE_DIR=./data/tts_cache

# Auth
JWT_SECRET=change-me-in-production

# OAuth: Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth: GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:3000
