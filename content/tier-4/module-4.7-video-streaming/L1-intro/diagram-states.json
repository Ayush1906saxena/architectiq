{
  "diagram": "video-streaming-design",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_upload_pipeline": {
      "elements_visible": ["creator", "upload_service", "chunk_indicators", "object_storage", "progress_bar"],
      "description": "Chunked resumable upload from creator to object storage",
      "enter_animation": {
        "type": "upload_progress",
        "duration_ms": 2500
      }
    },
    "show_transcoding": {
      "elements_visible": ["raw_video", "transcoder", "output_240p", "output_480p", "output_720p", "output_1080p", "output_4k"],
      "description": "Raw video being transcoded into multiple resolutions and codecs",
      "enter_animation": {
        "type": "fanout_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "show_dag_pipeline": {
      "elements_visible": ["video_segments", "parallel_workers", "merge_step", "dag_arrows"],
      "description": "DAG of transcoding tasks — split, parallel transcode, merge",
      "enter_animation": {
        "type": "dag_flow",
        "duration_ms": 2500
      }
    },
    "show_abr": {
      "elements_visible": ["player", "bandwidth_meter", "quality_levels", "segment_timeline", "quality_switches"],
      "description": "Adaptive bitrate switching quality level segment by segment based on bandwidth",
      "enter_animation": {
        "type": "quality_switch_sequence",
        "duration_ms": 3000
      }
    },
    "show_manifest": {
      "elements_visible": ["manifest_file", "quality_list", "segment_urls", "player_selector"],
      "description": "HLS manifest listing segments at each quality level",
      "enter_animation": {
        "type": "parse_and_select",
        "duration_ms": 2000
      }
    },
    "show_cdn_distribution": {
      "elements_visible": ["origin_server", "edge_tokyo", "edge_london", "edge_nyc", "viewer_arrows", "world_map"],
      "description": "CDN serving video segments from edge locations worldwide",
      "enter_animation": {
        "type": "global_distribution",
        "duration_ms": 2500
      }
    },
    "show_hot_cold": {
      "elements_visible": ["popular_videos", "edge_cache", "long_tail", "origin_storage", "pull_on_demand"],
      "description": "Hot content cached at edge; cold content pulled from origin on demand",
      "enter_animation": {
        "type": "tier_split",
        "duration_ms": 2000
      }
    },
    "show_live_pipeline": {
      "elements_visible": ["camera", "ingest_server", "realtime_transcoder", "cdn_push", "viewers", "latency_indicator"],
      "description": "Live streaming pipeline with real-time transcoding and CDN push",
      "enter_animation": {
        "type": "live_flow",
        "duration_ms": 2500
      }
    },
    "full_streaming_architecture": {
      "elements_visible": ["upload", "transcode", "storage", "cdn", "players", "all_connections"],
      "description": "Complete video streaming architecture from upload to playback",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}