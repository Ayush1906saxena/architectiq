{
  "diagram": "payment-system-design",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_payment_lifecycle": {
      "elements_visible": ["created", "authorized", "captured", "settled", "lifecycle_arrows", "status_labels"],
      "description": "Payment lifecycle states from creation through settlement",
      "enter_animation": {
        "type": "state_flow",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "show_payment_network": {
      "elements_visible": ["merchant", "payment_gateway", "processor", "card_network", "issuing_bank", "flow_arrows"],
      "description": "Payment network showing request flow through all intermediaries",
      "enter_animation": {
        "type": "chain_flow",
        "duration_ms": 3000,
        "stagger_ms": 500
      }
    },
    "show_idempotency": {
      "elements_visible": ["request_1", "idempotency_key", "payment_record", "request_2_retry", "cached_response"],
      "description": "Idempotency key preventing duplicate charge on retry",
      "enter_animation": {
        "type": "duplicate_detect",
        "duration_ms": 2500
      }
    },
    "show_double_entry": {
      "elements_visible": ["ledger", "debit_entry", "credit_entry", "balance_zero", "accounts"],
      "description": "Double-entry ledger with debit and credit always balancing to zero",
      "enter_animation": {
        "type": "ledger_build",
        "duration_ms": 2000
      }
    },
    "show_reconciliation": {
      "elements_visible": ["internal_ledger", "bank_statement", "comparison_arrows", "match_indicators", "discrepancy_flag"],
      "description": "Reconciliation comparing internal ledger against bank statements",
      "enter_animation": {
        "type": "comparison_flow",
        "duration_ms": 2500
      }
    },
    "show_fraud_detection": {
      "elements_visible": ["transaction", "ml_model", "risk_signals", "risk_score", "decision_block_or_allow"],
      "description": "Real-time fraud scoring with ML model analyzing risk signals",
      "enter_animation": {
        "type": "scoring_flow",
        "duration_ms": 2000
      }
    },
    "show_pci_tokenization": {
      "elements_visible": ["card_number", "tokenization_service", "opaque_token", "secure_vault", "application_layer"],
      "description": "Card numbers replaced with tokens — application layer only sees tokens",
      "enter_animation": {
        "type": "tokenize_flow",
        "duration_ms": 2000
      }
    },
    "show_high_availability": {
      "elements_visible": ["dc_primary", "dc_secondary", "sync_replication", "failover_arrow", "queue_buffer"],
      "description": "Active-active deployment with synchronous replication and failover",
      "enter_animation": {
        "type": "dual_dc_animation",
        "duration_ms": 2500
      }
    },
    "full_payment_architecture": {
      "elements_visible": ["api_gateway", "payment_service", "ledger", "fraud_engine", "token_vault", "processor_integrations", "reconciliation"],
      "description": "Complete payment system architecture with all components",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}