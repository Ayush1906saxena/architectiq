{
  "diagram": "kafka-design",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_append_log": {
      "elements_visible": ["log_segments", "write_pointer", "read_pointers"],
      "description": "An append-only log with messages being added sequentially",
      "enter_animation": {
        "type": "append_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "show_topic_partitions": {
      "elements_visible": ["topic_label", "partition_0", "partition_1", "partition_2", "broker_labels"],
      "description": "A topic split into three partitions across different brokers",
      "enter_animation": {
        "type": "split_animation",
        "duration_ms": 2000
      }
    },
    "show_producer_routing": {
      "elements_visible": ["producer", "partition_key", "hash_function", "partition_0", "partition_1", "partition_2", "routing_arrows"],
      "description": "Producer routing messages to partitions based on key hash",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 2500,
        "stagger_ms": 600
      }
    },
    "show_ack_levels": {
      "elements_visible": ["producer", "leader", "follower_1", "follower_2", "ack_0_label", "ack_1_label", "ack_all_label"],
      "description": "Three ack levels compared side by side with latency and durability indicators",
      "enter_animation": {
        "type": "comparison_build",
        "duration_ms": 2000
      }
    },
    "show_replication": {
      "elements_visible": ["leader_broker", "follower_broker_1", "follower_broker_2", "isr_indicator", "sync_arrows"],
      "description": "Leader replicating to followers with ISR tracking",
      "enter_animation": {
        "type": "replication_flow",
        "duration_ms": 2500
      }
    },
    "show_consumer_groups": {
      "elements_visible": ["partition_0", "partition_1", "partition_2", "consumer_a", "consumer_b", "consumer_c", "assignment_lines"],
      "description": "Each partition assigned to exactly one consumer in the group",
      "enter_animation": {
        "type": "assignment_animation",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "show_offsets": {
      "elements_visible": ["partition_log", "offset_markers", "consumer_position", "committed_offset"],
      "description": "Consumer tracking position with committed offset markers",
      "enter_animation": {
        "type": "offset_tracking",
        "duration_ms": 2000
      }
    },
    "show_exactly_once": {
      "elements_visible": ["producer", "sequence_number", "transaction_boundary", "consumer", "atomic_commit"],
      "description": "Exactly-once semantics with idempotent producer and transactional commit",
      "enter_animation": {
        "type": "transaction_animation",
        "duration_ms": 2500
      }
    },
    "full_kafka_architecture": {
      "elements_visible": ["producers", "brokers", "partitions", "replicas", "consumer_groups", "zookeeper"],
      "description": "Complete Kafka architecture with all components",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}