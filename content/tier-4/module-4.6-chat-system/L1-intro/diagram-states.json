{
  "diagram": "chat-system-design",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_polling_waste": {
      "elements_visible": ["client", "server", "polling_arrows", "empty_responses", "wasted_label"],
      "description": "Client polling server repeatedly with mostly empty responses",
      "enter_animation": {
        "type": "repeated_request",
        "duration_ms": 3000,
        "stagger_ms": 500
      }
    },
    "show_websocket": {
      "elements_visible": ["client", "server", "persistent_connection", "bidirectional_arrows"],
      "description": "Single persistent WebSocket connection with bidirectional data flow",
      "enter_animation": {
        "type": "handshake_then_flow",
        "duration_ms": 2000
      }
    },
    "show_connection_manager": {
      "elements_visible": ["alice", "bob", "ws_server_1", "ws_server_2", "connection_registry", "route_arrow"],
      "description": "Connection manager tracking user-to-server mapping and routing messages",
      "enter_animation": {
        "type": "lookup_and_route",
        "duration_ms": 2500
      }
    },
    "show_store_forward": {
      "elements_visible": ["sender", "server", "message_queue", "offline_recipient", "delivery_arrow"],
      "description": "Messages stored in queue when recipient is offline, delivered on reconnect",
      "enter_animation": {
        "type": "store_then_forward",
        "duration_ms": 2500
      }
    },
    "show_ordering": {
      "elements_visible": ["sender", "message_1", "message_2", "sequence_numbers", "ordered_display"],
      "description": "Messages assigned sequence numbers for correct ordering regardless of arrival",
      "enter_animation": {
        "type": "sequence_assignment",
        "duration_ms": 2000
      }
    },
    "show_presence": {
      "elements_visible": ["users", "heartbeat_signals", "presence_service", "online_indicators", "timeout_timer"],
      "description": "Heartbeat-based presence tracking with timeout for offline detection",
      "enter_animation": {
        "type": "heartbeat_pulse",
        "duration_ms": 2500
      }
    },
    "show_group_messaging": {
      "elements_visible": ["sender", "group_service", "message_queue", "member_1", "member_2", "member_3", "fanout_arrows"],
      "description": "Group message fanning out through queue to all group members",
      "enter_animation": {
        "type": "fanout_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "show_e2e_encryption": {
      "elements_visible": ["alice_client", "encrypted_message", "server_ciphertext", "bob_client", "decrypted_message", "key_exchange"],
      "description": "End-to-end encryption where server only sees ciphertext",
      "enter_animation": {
        "type": "encrypt_route_decrypt",
        "duration_ms": 3000
      }
    },
    "full_chat_architecture": {
      "elements_visible": ["clients", "load_balancer", "ws_servers", "connection_manager", "message_service", "presence_service", "storage", "queue"],
      "description": "Complete chat system architecture with all components",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}