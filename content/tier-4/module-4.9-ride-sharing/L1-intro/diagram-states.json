{
  "diagram": "ride-sharing-design",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_location_problem": {
      "elements_visible": ["map", "rider", "scattered_drivers", "radius_circle"],
      "description": "Rider on a map with scattered drivers — need to find nearby ones",
      "enter_animation": {
        "type": "scatter_and_circle",
        "duration_ms": 2000
      }
    },
    "show_geohash": {
      "elements_visible": ["map_grid", "geohash_labels", "rider_cell", "neighbor_cells", "prefix_highlight"],
      "description": "Map divided into geohash cells with shared prefix highlighting",
      "enter_animation": {
        "type": "grid_overlay",
        "duration_ms": 2500
      }
    },
    "show_driver_updates": {
      "elements_visible": ["drivers", "gps_pings", "redis_store", "geohash_index", "query_arrows"],
      "description": "Drivers sending GPS updates to location service with geohash indexing",
      "enter_animation": {
        "type": "ping_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "show_matching": {
      "elements_visible": ["rider", "candidate_drivers", "eta_labels", "direction_arrows", "selected_driver"],
      "description": "Matching algorithm comparing drivers by ETA and direction",
      "enter_animation": {
        "type": "comparison_select",
        "duration_ms": 2500
      }
    },
    "show_eta": {
      "elements_visible": ["road_network", "speed_data", "ml_model", "predicted_eta", "time_segments"],
      "description": "ETA prediction using historical speed data and ML model",
      "enter_animation": {
        "type": "model_prediction",
        "duration_ms": 2000
      }
    },
    "show_tracking": {
      "elements_visible": ["map", "driver_car", "rider_location", "websocket_stream", "route_line"],
      "description": "Real-time driver tracking with car moving on map via WebSocket",
      "enter_animation": {
        "type": "car_movement",
        "duration_ms": 3000
      }
    },
    "show_surge": {
      "elements_visible": ["demand_heatmap", "supply_indicators", "surge_zones", "multiplier_labels", "price_arrows"],
      "description": "Surge pricing heatmap showing demand-supply imbalance and price multipliers",
      "enter_animation": {
        "type": "heatmap_build",
        "duration_ms": 2500
      }
    },
    "show_dispatch": {
      "elements_visible": ["state_machine", "requested", "matched", "en_route", "in_progress", "completed", "transition_arrows"],
      "description": "Trip state machine from requested to completed",
      "enter_animation": {
        "type": "state_flow",
        "duration_ms": 2500
      }
    },
    "full_ridesharing_architecture": {
      "elements_visible": ["rider_app", "driver_app", "api_gateway", "matching_service", "location_service", "pricing_service", "trip_service"],
      "description": "Complete ride-sharing architecture with all services",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}