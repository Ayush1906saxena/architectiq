{
  "diagram": "trip-surge-pricing",
  "initial_state": "empty",
  "states": {
    "empty": { "elements_visible": [], "description": "Nothing shown yet" },
    "show_state_machine": {
      "elements_visible": ["states", "transitions", "rules", "version_lock"],
      "description": "Trip state machine: requested→matched→en_route→arrived→in_trip→completed with rules",
      "enter_animation": { "type": "state_machine_build", "duration_ms": 3000 }
    },
    "show_surge_pricing": {
      "elements_visible": ["supply_bar", "demand_bar", "ratio", "surge_multiplier"],
      "description": "Surge pricing: supply-demand ratio driving price multiplier",
      "enter_animation": { "type": "ratio_calculation", "duration_ms": 2500 }
    },
    "show_surge_computation": {
      "elements_visible": ["geohash_map", "rider_counts", "driver_counts", "surge_heatmap"],
      "description": "Per-geohash surge computation with smoothing between adjacent cells",
      "enter_animation": { "type": "heatmap_build", "duration_ms": 2500 }
    },
    "show_dispatch_partition": {
      "elements_visible": ["city_partitions", "dispatch_servers", "boundary_matching"],
      "description": "Dispatch partitioned by geohash with cross-boundary matching",
      "enter_animation": { "type": "partition_map", "duration_ms": 2500 }
    },
    "show_eta_computation": {
      "elements_visible": ["road_graph", "traffic_weights", "dijkstra_path", "eta_result"],
      "description": "ETA with live traffic: weighted road graph + shortest path computation",
      "enter_animation": { "type": "pathfinding", "duration_ms": 3000 }
    },
    "show_pricing": {
      "elements_visible": ["base_fare", "time_rate", "distance_rate", "surge", "total_price"],
      "description": "Upfront pricing: base + time + distance × surge = locked price",
      "enter_animation": { "type": "pricing_build", "duration_ms": 2000 }
    },
    "show_edge_cases": {
      "elements_visible": ["driver_cancel", "phone_dies", "route_mismatch", "handling_rules"],
      "description": "Edge cases: driver cancel, phone death, route mismatch with handling rules",
      "enter_animation": { "type": "case_list", "duration_ms": 2000 }
    },
    "show_full_system": {
      "elements_visible": ["state_machine", "pricing_engine", "dispatch", "eta_service"],
      "description": "Complete trip and pricing system architecture",
      "enter_animation": { "type": "zoom_out", "duration_ms": 2500 }
    }
  }
}