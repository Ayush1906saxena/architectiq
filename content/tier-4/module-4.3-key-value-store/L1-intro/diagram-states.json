{
  "diagram": "key-value-store",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "single_node_kv": {
      "elements_visible": ["node", "hash_map", "write_ahead_log", "disk_icon"],
      "description": "Single node with in-memory hash map and write-ahead log on disk",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "partitioning_ring": {
      "elements_visible": ["hash_ring", "node_a", "node_b", "node_c", "node_d", "key_markers"],
      "description": "Consistent hashing ring with four nodes and keys mapped to their owning nodes",
      "nodes": [
        { "id": "node_a", "position": 0, "label": "Node A" },
        { "id": "node_b", "position": 90, "label": "Node B" },
        { "id": "node_c", "position": 180, "label": "Node C" },
        { "id": "node_d", "position": 270, "label": "Node D" }
      ],
      "enter_animation": {
        "type": "morph_to_ring",
        "duration_ms": 2000
      }
    },
    "replication_quorum": {
      "elements_visible": ["hash_ring", "node_a", "node_b", "node_c", "node_d", "replication_arrows", "quorum_formula"],
      "description": "Show a key replicated to N=3 consecutive nodes with quorum formula R+W>N",
      "replication": {
        "key": "user:123",
        "primary": "node_b",
        "replicas": ["node_c", "node_d"],
        "N": 3,
        "W": 2,
        "R": 2
      },
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "write_path": {
      "elements_visible": ["client", "coordinator", "replica_1", "replica_2", "replica_3", "write_arrows", "ack_arrows"],
      "description": "Write path: client -> coordinator -> N replicas, W acks return success",
      "flow": [
        { "from": "client", "to": "coordinator", "label": "PUT key=val" },
        { "from": "coordinator", "to": "replica_1", "label": "replicate" },
        { "from": "coordinator", "to": "replica_2", "label": "replicate" },
        { "from": "coordinator", "to": "replica_3", "label": "replicate" },
        { "from": "replica_1", "to": "coordinator", "label": "ACK" },
        { "from": "replica_2", "to": "coordinator", "label": "ACK" },
        { "from": "coordinator", "to": "client", "label": "SUCCESS (W=2 met)" }
      ],
      "enter_animation": {
        "type": "trace_path",
        "duration_ms": 3000
      }
    },
    "read_path": {
      "elements_visible": ["client", "coordinator", "replica_1", "replica_2", "replica_3", "read_arrows", "response_arrows", "read_repair"],
      "description": "Read path: coordinator queries N replicas, waits for R, read-repairs stale nodes",
      "flow": [
        { "from": "client", "to": "coordinator", "label": "GET key" },
        { "from": "coordinator", "to": "replica_1", "label": "read" },
        { "from": "coordinator", "to": "replica_2", "label": "read" },
        { "from": "coordinator", "to": "replica_3", "label": "read" },
        { "from": "replica_1", "to": "coordinator", "label": "val v2" },
        { "from": "replica_2", "to": "coordinator", "label": "val v2" },
        { "from": "replica_3", "to": "coordinator", "label": "val v1 (stale)" },
        { "from": "coordinator", "to": "client", "label": "return v2" },
        { "from": "coordinator", "to": "replica_3", "label": "read-repair v2" }
      ],
      "enter_animation": {
        "type": "trace_path",
        "duration_ms": 3500
      }
    },
    "conflict_scenario": {
      "elements_visible": ["client_a", "client_b", "replica_1", "replica_2", "vector_clock_display", "conflict_marker"],
      "description": "Two clients write to the same key on different replicas, vector clocks diverge",
      "conflict": {
        "key": "item:42",
        "client_a_write": { "value": "price=10", "vector_clock": "[A:2, B:1]" },
        "client_b_write": { "value": "price=15", "vector_clock": "[A:1, B:2]" },
        "result": "Neither dominates — conflict detected"
      },
      "enter_animation": {
        "type": "step_sequence",
        "duration_ms": 3000,
        "stagger_ms": 800
      }
    },
    "gossip_protocol": {
      "elements_visible": ["node_a", "node_b", "node_c", "node_d", "node_e", "gossip_arrows", "membership_lists"],
      "description": "Gossip protocol: nodes exchange membership info with random peers, info spreads exponentially",
      "gossip_rounds": [
        { "round": 1, "from": "node_a", "to": "node_c", "info": "node_e is down" },
        { "round": 2, "from": "node_c", "to": "node_b", "info": "node_e is down" },
        { "round": 2, "from": "node_a", "to": "node_d", "info": "node_e is down" }
      ],
      "enter_animation": {
        "type": "gossip_spread",
        "duration_ms": 3000,
        "stagger_ms": 800
      }
    },
    "full_architecture": {
      "elements_visible": ["hash_ring", "all_nodes", "replication_indicators", "coordinator", "client", "gossip_overlay", "merkle_indicator"],
      "description": "Complete distributed KV store: hash ring, replicated nodes, coordinator, gossip, and Merkle trees",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 300
      }
    }
  }
}
