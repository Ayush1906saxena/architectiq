{
  "diagram": "rate-limiter",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "why_rate_limit": {
      "elements_visible": ["reason_abuse", "reason_resources", "reason_costs", "reason_fairness", "attack_visual"],
      "description": "Show four reason cards and a visualization of one client overwhelming a server",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "token_bucket_visual": {
      "elements_visible": ["bucket", "tokens", "faucet", "request_queue", "allow_deny_indicator"],
      "description": "Animated token bucket with faucet dripping tokens, requests consuming tokens",
      "bucket_config": {
        "capacity": 10,
        "refill_rate": "1 token/sec",
        "current_tokens": 10
      },
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "sliding_window": {
      "elements_visible": ["time_axis", "current_window", "previous_window", "overlap_zone", "weighted_count"],
      "description": "Show sliding window overlapping two fixed windows with weighted count calculation",
      "enter_animation": {
        "type": "slide_in",
        "duration_ms": 1500
      }
    },
    "fixed_window": {
      "elements_visible": ["time_axis", "window_1", "window_2", "boundary_line", "spike_indicator"],
      "description": "Show fixed time windows with the boundary spike problem highlighted",
      "windows": [
        { "id": "window_1", "range": "0:00-1:00", "count": 100 },
        { "id": "window_2", "range": "1:00-2:00", "count": 100 }
      ],
      "boundary_issue": "200 requests in a 1-second span around the boundary",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "distributed_redis": {
      "elements_visible": ["server_1", "server_2", "server_3", "redis_cluster", "counter_display", "incr_arrows"],
      "description": "Multiple API servers sharing a Redis counter for distributed rate limiting",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 300
      }
    },
    "race_condition": {
      "elements_visible": ["server_1", "server_2", "redis", "timeline", "race_highlight"],
      "description": "Timeline showing two servers reading the same counter value simultaneously",
      "race_steps": [
        { "time": "t1", "actor": "server_1", "action": "READ counter = 99" },
        { "time": "t1", "actor": "server_2", "action": "READ counter = 99" },
        { "time": "t2", "actor": "server_1", "action": "INCR -> 100 (allowed)" },
        { "time": "t2", "actor": "server_2", "action": "INCR -> 101 (should have been denied!)" }
      ],
      "enter_animation": {
        "type": "step_sequence",
        "duration_ms": 3000,
        "stagger_ms": 700
      }
    },
    "gateway_vs_app": {
      "elements_visible": ["client", "api_gateway", "gateway_limiter", "app_servers", "app_limiter", "database"],
      "description": "Show rate limiting at two layers: API gateway (broad) and application level (fine-grained)",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 300
      }
    }
  }
}
