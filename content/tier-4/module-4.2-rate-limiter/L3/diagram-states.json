{
  "diagram": "rate-limiter-advanced",
  "initial_state": "empty",
  "states": {
    "empty": { "elements_visible": [], "description": "Nothing shown yet" },
    "show_sliding_log": {
      "elements_visible": ["timestamp_list", "window_boundary", "count_indicator"],
      "description": "Sliding window log: timestamps stored in sorted set, window slides over time",
      "enter_animation": { "type": "window_slide", "duration_ms": 2500 }
    },
    "show_sliding_counter": {
      "elements_visible": ["previous_window", "current_window", "overlap_region", "formula"],
      "description": "Sliding window counter: weighted average of previous and current window counts",
      "enter_animation": { "type": "calculation_flow", "duration_ms": 2500 }
    },
    "show_api_tiers": {
      "elements_visible": ["free_tier", "basic_tier", "enterprise_tier", "limits_per_tier"],
      "description": "API key tiers with different rate limits: 25/100/custom requests per second",
      "enter_animation": { "type": "tier_stack", "duration_ms": 2000 }
    },
    "show_distributed": {
      "elements_visible": ["region_us", "region_eu", "region_asia", "sync_arrows", "central_counter"],
      "description": "Distributed rate limiting across three regions with sync strategies",
      "enter_animation": { "type": "regions_with_sync", "duration_ms": 3000 }
    },
    "show_graceful_degradation": {
      "elements_visible": ["request_flow", "rate_check", "queue_path", "reject_path", "retry_after"],
      "description": "Graceful degradation: queue vs reject with Retry-After header",
      "enter_animation": { "type": "decision_flow", "duration_ms": 2500 }
    },
    "show_headers": {
      "elements_visible": ["http_response", "rate_limit_header", "remaining_header", "reset_header"],
      "description": "X-RateLimit response headers breakdown for client self-throttling",
      "enter_animation": { "type": "header_expand", "duration_ms": 2000 }
    },
    "show_race_condition": {
      "elements_visible": ["request_a", "request_b", "counter", "redis_atomic_op"],
      "description": "Race condition: two concurrent reads before increment, solved with atomic operations",
      "enter_animation": { "type": "race_demo", "duration_ms": 2500 }
    },
    "show_full_architecture": {
      "elements_visible": ["gateway", "rate_limiter", "redis_cluster", "api_tiers", "response_headers"],
      "description": "Complete distributed rate limiting architecture",
      "enter_animation": { "type": "zoom_out", "duration_ms": 2000 }
    }
  }
}