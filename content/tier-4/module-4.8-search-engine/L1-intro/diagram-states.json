{
  "diagram": "search-engine-design",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_crawling": {
      "elements_visible": ["crawler", "seed_urls", "web_pages", "link_arrows", "frontier_queue"],
      "description": "Web crawler traversing pages via links in breadth-first order",
      "enter_animation": {
        "type": "bfs_traversal",
        "duration_ms": 3000,
        "stagger_ms": 500
      }
    },
    "show_dedup": {
      "elements_visible": ["incoming_urls", "bloom_filter", "simhash", "unique_pages", "duplicates_rejected"],
      "description": "URL and content deduplication using bloom filter and simhash",
      "enter_animation": {
        "type": "filter_flow",
        "duration_ms": 2000
      }
    },
    "show_inverted_index": {
      "elements_visible": ["word_list", "posting_lists", "document_refs", "intersection_highlight"],
      "description": "Inverted index mapping words to document posting lists",
      "enter_animation": {
        "type": "index_build",
        "duration_ms": 2500
      }
    },
    "show_tfidf": {
      "elements_visible": ["term_frequency", "inverse_doc_frequency", "score_formula", "ranked_docs"],
      "description": "TF-IDF scoring calculation with formula and example documents",
      "enter_animation": {
        "type": "calculation_flow",
        "duration_ms": 2000
      }
    },
    "show_pagerank": {
      "elements_visible": ["page_nodes", "link_edges", "rank_values", "authority_flow"],
      "description": "PageRank link graph with authority flowing through links",
      "enter_animation": {
        "type": "graph_iteration",
        "duration_ms": 3000
      }
    },
    "show_query_pipeline": {
      "elements_visible": ["query_input", "spell_check", "synonym_expansion", "index_lookup", "scoring", "results"],
      "description": "Query processing pipeline from input to ranked results",
      "enter_animation": {
        "type": "pipeline_flow",
        "duration_ms": 2500
      }
    },
    "show_sharding": {
      "elements_visible": ["coordinator", "shard_1", "shard_2", "shard_3", "parallel_arrows", "merge_step"],
      "description": "Query broadcast to index shards in parallel with result merging",
      "enter_animation": {
        "type": "parallel_fanout",
        "duration_ms": 2500
      }
    },
    "show_tiered_index": {
      "elements_visible": ["realtime_index", "batch_index", "merge_results", "freshness_label"],
      "description": "Tiered indexing with real-time and batch indexes merged at query time",
      "enter_animation": {
        "type": "tier_merge",
        "duration_ms": 2000
      }
    },
    "full_search_architecture": {
      "elements_visible": ["crawlers", "indexer", "index_shards", "query_service", "ranking", "all_connections"],
      "description": "Complete search engine architecture from crawling to query serving",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}