{
  "diagram": "building-search-index",
  "initial_state": "empty",
  "states": {
    "empty": { "elements_visible": [], "description": "Nothing shown yet" },
    "show_posting_list": {
      "elements_visible": ["term", "posting_entries", "doc_ids", "positions", "frequencies"],
      "description": "Posting list structure: term → sorted list of (doc_id, frequency, positions)",
      "enter_animation": { "type": "list_build", "duration_ms": 2500 }
    },
    "show_mapreduce_indexing": {
      "elements_visible": ["documents", "mappers", "intermediate_tuples", "reducers", "posting_lists"],
      "description": "MapReduce index building: map(doc)→(term,doc,pos), reduce→sorted posting list",
      "enter_animation": { "type": "mapreduce_flow", "duration_ms": 3000 }
    },
    "show_skip_pointers": {
      "elements_visible": ["posting_list_a", "posting_list_b", "skip_pointers", "intersection_path"],
      "description": "Skip pointers enabling O(sqrt(N)) posting list intersection",
      "enter_animation": { "type": "skip_traverse", "duration_ms": 2500 }
    },
    "show_compression": {
      "elements_visible": ["raw_ids", "delta_encoded", "varint_encoded", "compression_ratio"],
      "description": "Index compression: delta encoding + varint/PForDelta for 3-5x compression",
      "enter_animation": { "type": "compression_demo", "duration_ms": 2500 }
    },
    "show_sharding_strategies": {
      "elements_visible": ["doc_partitioned", "term_partitioned", "query_flow_comparison"],
      "description": "Document-partitioned (scatter-gather) vs term-partitioned (targeted) sharding",
      "enter_animation": { "type": "split_compare", "duration_ms": 2500 }
    },
    "show_replication": {
      "elements_visible": ["shards", "replicas", "load_balancer", "failure_handling"],
      "description": "Shard replicas for read throughput and fault tolerance",
      "enter_animation": { "type": "replica_grid", "duration_ms": 2000 }
    },
    "show_incremental_index": {
      "elements_visible": ["memory_index", "disk_index", "merge_process", "lucene_segments"],
      "description": "Tiered index: in-memory for real-time + periodic merge to on-disk segments",
      "enter_animation": { "type": "merge_animation", "duration_ms": 2500 }
    },
    "show_full_pipeline": {
      "elements_visible": ["crawl", "index_build", "compress", "shard", "serve"],
      "description": "Complete search indexing pipeline from crawl to serving",
      "enter_animation": { "type": "zoom_out", "duration_ms": 2500 }
    }
  }
}