{
  "diagram": "storage-deep-dive",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "hdd_visible": {
      "elements_visible": ["hdd_platters", "read_head", "spindle"],
      "description": "Hard disk drive with spinning platters and a read/write head sweeping across",
      "enter_animation": {
        "type": "spin_and_fade",
        "duration_ms": 1500
      }
    },
    "ssd_visible": {
      "elements_visible": ["hdd_platters", "ssd_chip", "comparison_arrows"],
      "description": "SSD chip appears alongside HDD with speed comparison indicators",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "seq_vs_random": {
      "elements_visible": ["disk_surface", "sequential_path", "random_path", "speed_labels"],
      "description": "Sequential reads shown as a smooth sweep, random reads as chaotic jumps across the disk",
      "sequential_pattern": { "type": "smooth_sweep", "label": "Sequential: ~500 MB/s" },
      "random_pattern": { "type": "chaotic_jumps", "label": "Random: ~1 MB/s (HDD)" },
      "enter_animation": {
        "type": "parallel_animation",
        "duration_ms": 2000
      }
    },
    "filesystem_layer": {
      "elements_visible": ["application_layer", "filesystem_layer", "disk_blocks", "mapping_arrows"],
      "description": "File system layer translating files and directories to disk block addresses",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "page_cache": {
      "elements_visible": ["application", "page_cache_ram", "disk", "cache_hit_path", "cache_miss_path"],
      "description": "Page cache sitting in RAM between application and disk, showing hit and miss paths",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "wal_concept": {
      "elements_visible": ["data_file", "power_failure_icon", "corrupted_data"],
      "description": "Power failure scenario showing half-written corrupted data on disk",
      "enter_animation": {
        "type": "crash_sequence",
        "duration_ms": 1500,
        "effects": ["flash", "corruption_marks"]
      }
    },
    "wal_flow": {
      "elements_visible": ["wal_log_file", "data_file", "write_to_log_arrow", "apply_to_data_arrow", "recovery_arrow"],
      "description": "Write-ahead log flow: write to log first, then apply to data file, with recovery path",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 2000,
        "stagger_ms": 600
      }
    },
    "full_picture": {
      "elements_visible": ["hdd", "ssd", "filesystem", "page_cache", "wal", "application"],
      "description": "Complete storage stack from application through page cache, filesystem, and disk hardware",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}
