{
  "diagram": "cache-invalidation",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "stale_data_problem": {
      "elements_visible": ["cache_entry", "database_value", "mismatch_indicator"],
      "description": "Cache shows old value while database has new value — mismatch highlighted",
      "enter_animation": {
        "type": "split_reveal",
        "duration_ms": 2000
      }
    },
    "ttl_strategy": {
      "elements_visible": ["cache_entry", "ttl_countdown", "expiry_trigger", "db_fetch"],
      "description": "TTL countdown on cache entry, expires, fresh data fetched from database",
      "enter_animation": {
        "type": "countdown_sequence",
        "duration_ms": 3000
      }
    },
    "write_through": {
      "elements_visible": ["app", "cache", "database", "simultaneous_write_arrows"],
      "description": "Write hits both cache and database simultaneously",
      "enter_animation": {
        "type": "parallel_flow",
        "duration_ms": 2000
      }
    },
    "write_behind": {
      "elements_visible": ["app", "cache", "database", "async_write_arrow", "queue_buffer"],
      "description": "Write hits cache immediately, asynchronously flushes to database",
      "enter_animation": {
        "type": "async_flow",
        "duration_ms": 2500
      }
    },
    "strategy_comparison": {
      "elements_visible": ["write_through_card", "write_behind_card", "ttl_card", "tradeoff_labels"],
      "description": "Three strategy cards with consistency vs speed tradeoffs",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "cache_stampede": {
      "elements_visible": ["expired_entry", "request_flood", "database", "overload_indicator"],
      "description": "Hundreds of requests hitting database simultaneously after cache expiry",
      "enter_animation": {
        "type": "flood_animation",
        "duration_ms": 3000
      }
    },
    "stampede_solutions": {
      "elements_visible": ["lock_approach", "background_refresh", "solution_labels"],
      "description": "Two solutions: single-flight lock and proactive background refresh",
      "enter_animation": {
        "type": "split_reveal",
        "duration_ms": 2000
      }
    },
    "probabilistic_expiry": {
      "elements_visible": ["probability_curve", "ttl_axis", "refresh_probability_axis"],
      "description": "Graph showing refresh probability increasing as TTL approaches zero",
      "enter_animation": {
        "type": "curve_draw",
        "duration_ms": 2500
      }
    },
    "cache_aside": {
      "elements_visible": ["app", "cache", "database", "read_path", "write_path", "delete_on_write"],
      "description": "Cache-aside pattern: read populates, write deletes cache entry",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "invalidation_summary": {
      "elements_visible": ["summary_card"],
      "description": "Summary card with cache invalidation strategies and best practices",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}