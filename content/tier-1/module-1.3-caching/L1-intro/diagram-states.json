{
  "diagram": "caching",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "client_server_db": {
      "elements_visible": ["client", "server", "database", "request_arrow", "response_arrow"],
      "description": "Basic three-tier: client, server, database with arrows",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "slow_query": {
      "elements_visible": ["client", "server", "database", "repeated_queries", "latency_label"],
      "description": "Multiple identical queries hitting the database with 200ms latency labels",
      "enter_animation": {
        "type": "repeated_flow",
        "duration_ms": 3000,
        "stagger_ms": 400
      }
    },
    "cache_appears": {
      "elements_visible": ["client", "server", "cache_layer", "database"],
      "description": "A cache layer appears between server and database, glowing to indicate fast memory",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200,
        "effects": ["glow_pulse"]
      }
    },
    "cache_hit": {
      "elements_visible": ["client", "server", "cache_layer", "database", "hit_flow", "speed_badge"],
      "description": "Request hits cache and returns in 2ms, speed comparison badge shown",
      "enter_animation": {
        "type": "fast_flow",
        "duration_ms": 1500
      }
    },
    "cache_miss": {
      "elements_visible": ["client", "server", "cache_layer", "database", "miss_flow", "store_arrow"],
      "description": "Request misses cache, goes to database, result stored back in cache",
      "enter_animation": {
        "type": "miss_sequence",
        "duration_ms": 3000,
        "steps": ["check_cache", "miss_indicator", "query_db", "store_in_cache"]
      }
    },
    "ttl_expiry": {
      "elements_visible": ["client", "server", "cache_layer", "database", "ttl_timer", "expired_entry"],
      "description": "A TTL countdown on a cache entry; entry fades out when timer reaches zero",
      "enter_animation": {
        "type": "countdown_sequence",
        "duration_ms": 3000,
        "effects": ["timer_tick", "entry_fade"]
      }
    },
    "cache_aside": {
      "elements_visible": ["client", "server", "cache_layer", "database", "aside_flow_arrows", "pattern_label"],
      "description": "Cache-aside pattern: 1) check cache, 2) on miss query DB, 3) store in cache",
      "flow_steps": [
        { "step": 1, "label": "Check cache", "from": "server", "to": "cache_layer" },
        { "step": 2, "label": "Miss → query DB", "from": "server", "to": "database" },
        { "step": 3, "label": "Store result", "from": "server", "to": "cache_layer" }
      ],
      "enter_animation": {
        "type": "step_sequence",
        "duration_ms": 3500,
        "stagger_ms": 1000
      }
    },
    "write_through": {
      "elements_visible": ["client", "server", "cache_layer", "database", "dual_write_arrows", "pattern_label"],
      "description": "Write-through pattern: writes go to both cache and database simultaneously",
      "enter_animation": {
        "type": "dual_flow",
        "duration_ms": 2000
      }
    }
  }
}