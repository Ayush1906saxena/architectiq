{
  "diagram": "redis-deep-dive",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "redis_strings": {
      "elements_visible": ["string_key", "string_value", "set_get_incr_commands"],
      "description": "Redis string with SET/GET/INCR operations demonstrated",
      "enter_animation": {
        "type": "command_sequence",
        "duration_ms": 2500,
        "stagger_ms": 600
      }
    },
    "redis_hashes": {
      "elements_visible": ["hash_key", "field_value_pairs", "hset_hget_commands"],
      "description": "Redis hash with fields and values, individual field access",
      "enter_animation": {
        "type": "expand_reveal",
        "duration_ms": 2000
      }
    },
    "lists_and_sets": {
      "elements_visible": ["list_visual", "set_visual", "sorted_set_visual", "operation_labels"],
      "description": "Three data structures side by side: list, set, sorted set with scores",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "use_case_mapping": {
      "elements_visible": ["structure_column", "use_case_column", "mapping_arrows"],
      "description": "Data structures mapped to real-world use cases",
      "enter_animation": {
        "type": "arrow_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "rdb_persistence": {
      "elements_visible": ["memory_state", "rdb_snapshot", "timeline", "gap_indicator"],
      "description": "Timeline showing periodic RDB snapshots with potential data loss gap",
      "enter_animation": {
        "type": "timeline_draw",
        "duration_ms": 2500
      }
    },
    "aof_persistence": {
      "elements_visible": ["write_operations", "aof_log", "rewrite_compaction"],
      "description": "AOF log growing with each write, then compacted by rewrite",
      "enter_animation": {
        "type": "log_grow",
        "duration_ms": 3000
      }
    },
    "memory_management": {
      "elements_visible": ["memory_bar", "maxmemory_line", "eviction_policy_label"],
      "description": "Memory usage bar approaching maxmemory limit with eviction trigger",
      "enter_animation": {
        "type": "bar_fill",
        "duration_ms": 2500
      }
    },
    "pubsub": {
      "elements_visible": ["publisher", "channel", "subscriber_1", "subscriber_2", "message_flow"],
      "description": "Publisher sending message through channel to multiple subscribers",
      "enter_animation": {
        "type": "broadcast_flow",
        "duration_ms": 2500
      }
    },
    "streams_vs_pubsub": {
      "elements_visible": ["pubsub_side", "streams_side", "persistence_indicator"],
      "description": "Pub/sub (fire-and-forget) vs Streams (persistent, replayable)",
      "enter_animation": {
        "type": "split_reveal",
        "duration_ms": 2000
      }
    },
    "replication": {
      "elements_visible": ["primary_node", "replica_1", "replica_2", "replication_arrows", "sentinel"],
      "description": "Primary-replica setup with Sentinel for failover",
      "enter_animation": {
        "type": "architecture_reveal",
        "duration_ms": 2500
      }
    },
    "redis_summary": {
      "elements_visible": ["summary_card"],
      "description": "Summary card with Redis capabilities and use cases",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}