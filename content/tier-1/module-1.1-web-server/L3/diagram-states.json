{
  "diagram": "reverse-proxy",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "forward_vs_reverse": {
      "elements_visible": ["client_group", "forward_proxy", "reverse_proxy", "server_group"],
      "description": "Side-by-side comparison of forward proxy (in front of clients) and reverse proxy (in front of servers)",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "tls_termination": {
      "elements_visible": ["client", "encrypted_link", "proxy", "plain_link", "backend_servers"],
      "description": "HTTPS encrypted traffic from client to proxy, plain HTTP from proxy to backends",
      "enter_animation": {
        "type": "flow_animation",
        "duration_ms": 1800
      }
    },
    "load_balancing": {
      "elements_visible": ["proxy", "backend_server_1", "backend_server_2", "backend_server_3", "distribution_arrows"],
      "description": "Proxy distributing requests across multiple backend servers with algorithm labels",
      "enter_animation": {
        "type": "fan_out",
        "duration_ms": 1500
      }
    },
    "proxy_caching": {
      "elements_visible": ["client", "proxy", "cache_store", "backend_servers", "cache_hit_arrow"],
      "description": "Proxy serving cached response directly without reaching backend",
      "enter_animation": {
        "type": "cache_hit_flow",
        "duration_ms": 1500
      }
    },
    "rate_limiting_shield": {
      "elements_visible": ["client_flood", "proxy_shield", "backend_servers"],
      "description": "Proxy blocking excessive requests while allowing legitimate traffic through",
      "enter_animation": {
        "type": "shield_animation",
        "duration_ms": 1500,
        "effects": ["block_flash", "allow_glow"]
      }
    },
    "health_checks": {
      "elements_visible": ["proxy", "healthy_servers", "failed_server", "health_pings"],
      "description": "Proxy sending health check pings, routing around a failed server",
      "enter_animation": {
        "type": "ping_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "production_layout": {
      "elements_visible": ["internet", "load_balancer", "nginx_instances", "app_servers", "database"],
      "description": "Full production architecture with layered proxy setup",
      "enter_animation": {
        "type": "build_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "summary_all_powers": {
      "elements_visible": ["proxy_center", "tls_badge", "lb_badge", "cache_badge", "compress_badge", "rate_badge", "health_badge"],
      "description": "Proxy in center with all capabilities shown as badges around it",
      "enter_animation": {
        "type": "radial_reveal",
        "duration_ms": 2000
      }
    }
