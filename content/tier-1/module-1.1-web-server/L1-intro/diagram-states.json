{
  "diagram": "web-server",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "socket_listening": {
      "elements_visible": ["server_box", "socket_port", "open_sign"],
      "description": "Server with a listening socket on port 80/443, 'Open' indicator glowing",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "connection_accepted": {
      "elements_visible": ["server_box", "socket_port", "client", "dedicated_socket"],
      "description": "Client connects, a new dedicated socket spawns while the original keeps listening",
      "enter_animation": {
        "type": "spawn_animation",
        "duration_ms": 1200
      }
    },
    "request_parsed": {
      "elements_visible": ["raw_bytes", "parsed_request", "method_label", "path_label", "headers_label"],
      "description": "Raw byte stream transforms into structured HTTP request components",
      "enter_animation": {
        "type": "morph_transform",
        "duration_ms": 1500
      }
    },
    "routing_table": {
      "elements_visible": ["route_get_users", "route_post_orders", "route_get_health", "match_arrow"],
      "description": "Routing table with path patterns matched to handler functions",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 300
      }
    },
    "thread_per_request": {
      "elements_visible": ["server_box", "thread_1", "thread_2", "thread_3", "thread_n", "memory_usage_bar"],
      "description": "Multiple threads spawned per connection, memory usage growing with each",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 300
      }
    },
    "event_loop": {
      "elements_visible": ["single_thread", "event_queue", "callback_arrows", "io_operations"],
      "description": "Single-threaded event loop processing callbacks from a queue, never blocking",
      "enter_animation": {
        "type": "loop_animation",
        "duration_ms": 2000
      }
    },
    "middleware_pipeline": {
      "elements_visible": ["auth_middleware", "logging_middleware", "rate_limit_middleware", "body_parser", "handler", "pipeline_arrows"],
      "description": "Request flowing through a pipeline of middleware layers before reaching the handler",
      "enter_animation": {
        "type": "flow_through",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "response_sent": {
      "elements_visible": ["handler", "response_object", "serialized_bytes", "socket_write"],
      "description": "Handler produces a response object, serialized to bytes and written to socket",
      "enter_animation": {
        "type": "flow_animation",
        "duration_ms": 1500
      }
    },
    "full_lifecycle": {
      "elements_visible": ["socket_accept", "parse", "route", "middleware", "handle", "respond", "lifecycle_arrows"],
      "description": "Complete request lifecycle shown as a horizontal flow from accept to response",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}
