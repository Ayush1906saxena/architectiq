{
  "diagram": "microservices",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "monolith_box": {
      "elements_visible": ["monolith_rectangle", "monolith_label", "internal_modules"],
      "description": "A single large rectangle labeled 'Monolith' with internal modules (Auth, Orders, Payments, Inventory)",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "monolith_growing": {
      "elements_visible": ["monolith_rectangle_expanded", "spaghetti_lines", "pain_points"],
      "description": "The monolith grows larger with tangled dependency lines and pain point labels (slow deploys, blast radius, team conflicts)",
      "pain_points": [
        "Slow deploys (1hr+)",
        "Full app crashes from one bug",
        "Team merge conflicts"
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 600
      }
    },
    "splitting_services": {
      "elements_visible": ["service_orders", "service_payments", "service_inventory", "service_users", "boundary_lines"],
      "description": "The monolith splits into four bounded services with clear boundary lines",
      "enter_animation": {
        "type": "split_animation",
        "duration_ms": 2500
      }
    },
    "service_communication": {
      "elements_visible": ["service_orders", "service_payments", "service_inventory", "sync_arrows", "async_arrows", "queue_icon"],
      "description": "Services communicate via REST (solid arrows) and async queues (dashed arrows with queue icon)",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "database_per_service": {
      "elements_visible": ["service_orders", "service_payments", "service_users", "db_orders", "db_payments", "db_users", "no_sharing_cross"],
      "description": "Each service has its own database cylinder; a red X over any cross-database arrows",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "operational_complexity": {
      "elements_visible": ["services_grid", "service_discovery", "distributed_tracing", "centralized_logging", "circuit_breakers", "deployment_pipelines"],
      "description": "A grid of services surrounded by operational concerns: discovery, tracing, logging, circuit breakers, CI/CD",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 400
      }
    },
    "monolith_first": {
      "elements_visible": ["timeline_arrow", "monolith_start", "growth_phase", "split_point", "microservices_end"],
      "description": "A timeline showing: start as monolith, grow, identify boundaries, then split when needed",
      "timeline_stages": [
        { "label": "Start Simple", "icon": "monolith" },
        { "label": "Grow & Learn", "icon": "expanding" },
        { "label": "Feel the Pain", "icon": "pain_point" },
        { "label": "Split Strategically", "icon": "microservices" }
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    }
  }
}
