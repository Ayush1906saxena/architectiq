{
  "diagram": "saga-pattern",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "two_phase_commit": {
      "elements_visible": ["coordinator", "participant_1", "participant_2", "prepare_arrows", "commit_arrows", "crash_indicator"],
      "description": "2PC coordinator sending prepare/commit, then crashing and blocking participants",
      "enter_animation": {
        "type": "flow_then_crash",
        "duration_ms": 2500
      }
    },
    "saga_sequence": {
      "elements_visible": ["step_1", "step_2", "step_3", "step_4", "forward_arrows", "compensation_arrows"],
      "description": "Four saga steps with forward flow and dotted compensation arrows going backward",
      "enter_animation": {
        "type": "sequence_animation",
        "duration_ms": 2500
      }
    },
    "order_saga_happy": {
      "elements_visible": ["order_service", "payment_service", "inventory_service", "shipping_service", "success_flow"],
      "description": "Order saga happy path: create, charge, reserve, ship — all succeeding",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "saga_compensation": {
      "elements_visible": ["order_service", "payment_service", "inventory_failed", "refund_arrow", "cancel_arrow"],
      "description": "Inventory step fails, triggering refund payment and cancel order compensations",
      "enter_animation": {
        "type": "fail_and_compensate",
        "duration_ms": 3000
      }
    },
    "choreography": {
      "elements_visible": ["order_service", "payment_service", "inventory_service", "event_bus", "event_arrows"],
      "description": "Services communicating via events on a bus, no central coordinator",
      "enter_animation": {
        "type": "event_chain",
        "duration_ms": 2500
      }
    },
    "choreography_complexity": {
      "elements_visible": ["many_services", "complex_event_web", "question_marks"],
      "description": "Many services connected by a complex web of events, hard to follow",
      "enter_animation": {
        "type": "complexity_reveal",
        "duration_ms": 2000
      }
    },
    "orchestration": {
      "elements_visible": ["orchestrator", "service_a", "service_b", "service_c", "command_arrows", "response_arrows"],
      "description": "Central orchestrator sending commands to services and receiving responses",
      "enter_animation": {
        "type": "hub_spoke_flow",
        "duration_ms": 2000
      }
    },
    "orchestration_risks": {
      "elements_visible": ["orchestrator_highlighted", "dependency_arrows", "spof_warning"],
      "description": "Orchestrator highlighted as single point of failure and coupling point",
      "enter_animation": {
        "type": "highlight_warning",
        "duration_ms": 1200
      }
    },
    "idempotency": {
      "elements_visible": ["duplicate_message_1", "duplicate_message_2", "idempotency_key", "single_execution"],
      "description": "Duplicate messages arriving but only processed once via idempotency key",
      "enter_animation": {
        "type": "dedup_animation",
        "duration_ms": 1500
      }
    },
    "comparison_summary": {
      "elements_visible": ["choreography_column", "orchestration_column", "comparison_criteria"],
      "description": "Side-by-side comparison of choreography vs orchestration",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}