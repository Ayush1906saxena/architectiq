{
  "diagram": "distributed-tracing",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_trace_context": {
      "elements_visible": ["traceparent_header", "trace_id", "span_id", "flags", "breakdown_labels"],
      "description": "W3C traceparent header broken down into version, trace-id, parent-span-id, flags",
      "enter_animation": { "type": "header_explode", "duration_ms": 2000 }
    },
    "show_span_tree": {
      "elements_visible": ["root_span", "child_spans", "grandchild_spans", "duration_bars"],
      "description": "Span tree showing gateway→auth→user-service with timing bars",
      "enter_animation": { "type": "tree_build", "duration_ms": 3000, "stagger_ms": 500 }
    },
    "show_jaeger_architecture": {
      "elements_visible": ["services", "jaeger_agents", "jaeger_collector", "storage", "jaeger_ui"],
      "description": "Jaeger pipeline: services→agent→collector→storage→UI",
      "enter_animation": { "type": "pipeline_flow", "duration_ms": 3000, "stagger_ms": 400 }
    },
    "show_sampling": {
      "elements_visible": ["head_sampling", "tail_sampling", "comparison_labels", "decision_points"],
      "description": "Head-based vs tail-based sampling comparison showing decision timing",
      "enter_animation": { "type": "split_comparison", "duration_ms": 2500 }
    },
    "show_n_plus_one": {
      "elements_visible": ["parent_span", "twenty_child_spans", "warning_indicator"],
      "description": "N+1 pattern visible as 20 identical child spans from one parent",
      "enter_animation": { "type": "span_multiply", "duration_ms": 2500 }
    },
    "show_uber_story": {
      "elements_visible": ["pricing_service", "currency_calls", "before_latency", "after_latency"],
      "description": "Uber story: 40 sequential currency calls (6s) → batched call (200ms)",
      "enter_animation": { "type": "before_after_morph", "duration_ms": 3000 }
    },
    "show_trace_testing": {
      "elements_visible": ["production_trace", "staging_trace", "diff_overlay", "pass_fail_indicator"],
      "description": "Trace-driven testing: comparing production vs staging span trees for regressions",
      "enter_animation": { "type": "overlay_compare", "duration_ms": 2500 }
    },
    "show_summary": {
      "elements_visible": ["tracing_pipeline", "key_practices", "tools"],
      "description": "Complete tracing overview with key practices highlighted",
      "enter_animation": { "type": "zoom_out", "duration_ms": 2000 }
    }
  }
}