{
  "diagram": "security-at-scale",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_password_antipattern": {
      "elements_visible": ["user", "third_party_app", "password_arrow", "red_cross"],
      "description": "Third-party app receiving user password directly — marked as anti-pattern",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "show_oauth_flow": {
      "elements_visible": ["user", "client_app", "auth_server", "resource_server", "redirect_arrows", "token"],
      "description": "OAuth 2.0 authorization code flow with redirect and token exchange",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "show_rbac": {
      "elements_visible": ["admin_role", "editor_role", "viewer_role", "permissions_matrix", "users"],
      "description": "RBAC hierarchy showing roles mapped to permissions",
      "enter_animation": {
        "type": "hierarchy_build",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "show_ddos_defense": {
      "elements_visible": ["traffic_flood", "edge_filter", "rate_limiter", "clean_traffic", "services"],
      "description": "DDoS traffic being filtered at the edge before reaching services",
      "enter_animation": {
        "type": "flood_and_filter",
        "duration_ms": 2500
      }
    },
    "show_mtls": {
      "elements_visible": ["service_a", "service_b", "tls_tunnel", "cert_exchange", "lock_icons"],
      "description": "Mutual TLS handshake between two services",
      "enter_animation": {
        "type": "handshake_sequence",
        "duration_ms": 2000
      }
    },
    "show_encryption_at_rest": {
      "elements_visible": ["database", "object_store", "encryption_layer", "kms", "key_rotation_arrow"],
      "description": "Data at rest encrypted with KMS managing key rotation",
      "enter_animation": {
        "type": "encrypt_sequence",
        "duration_ms": 2000
      }
    },
    "show_secret_management": {
      "elements_visible": ["vault", "services", "secret_fetch_arrows", "audit_log"],
      "description": "Services fetching secrets from Vault at runtime",
      "enter_animation": {
        "type": "fetch_animation",
        "duration_ms": 2000
      }
    },
    "show_defense_in_depth": {
      "elements_visible": ["layer_edge", "layer_gateway", "layer_service", "layer_data", "shield_icons"],
      "description": "Multiple security layers stacked — defense in depth",
      "enter_animation": {
        "type": "stack_build",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "full_security_architecture": {
      "elements_visible": ["all_layers", "all_connections", "security_labels"],
      "description": "Complete security architecture with all layers highlighted",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}