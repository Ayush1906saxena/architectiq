{
  "diagram": "api-gateway",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "chaos_direct_calls": {
      "elements_visible": ["mobile_client", "web_client", "service_1", "service_2", "service_3", "service_4", "service_5", "direct_arrows"],
      "description": "Clients making direct calls to multiple services — messy arrows everywhere",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 300
      }
    },
    "gateway_center": {
      "elements_visible": ["mobile_client", "web_client", "api_gateway", "service_1", "service_2", "service_3", "service_4", "service_5"],
      "description": "API gateway appears in center, arrows consolidate through it",
      "enter_animation": {
        "type": "morph_consolidate",
        "duration_ms": 2000
      }
    },
    "show_routing": {
      "elements_visible": ["api_gateway", "user_service", "order_service", "route_labels"],
      "description": "Show path-based routing from gateway to services",
      "routes": [
        { "path": "/users/*", "target": "user_service" },
        { "path": "/orders/*", "target": "order_service" }
      ],
      "enter_animation": {
        "type": "path_flow",
        "duration_ms": 2000,
        "stagger_ms": 800
      }
    },
    "show_auth_layer": {
      "elements_visible": ["api_gateway", "auth_shield", "jwt_token", "services"],
      "description": "Authentication layer shown as a shield on the gateway",
      "enter_animation": {
        "type": "shield_activate",
        "duration_ms": 1500
      }
    },
    "show_rate_limiting": {
      "elements_visible": ["api_gateway", "request_counter", "throttle_indicator", "services"],
      "description": "Rate limiting counter with requests being throttled",
      "enter_animation": {
        "type": "counter_increment",
        "duration_ms": 2000
      }
    },
    "show_bff_pattern": {
      "elements_visible": ["mobile_client", "web_client", "mobile_bff", "web_bff", "services"],
      "description": "Separate BFF gateways for mobile and web clients",
      "enter_animation": {
        "type": "split_animation",
        "duration_ms": 2000
      }
    },
    "show_service_mesh": {
      "elements_visible": ["service_a", "sidecar_a", "service_b", "sidecar_b", "service_c", "sidecar_c", "mesh_connections"],
      "description": "Each service paired with an Envoy sidecar proxy",
      "enter_animation": {
        "type": "sidecar_attach",
        "duration_ms": 2500,
        "stagger_ms": 600
      }
    },
    "show_north_south_east_west": {
      "elements_visible": ["api_gateway", "service_mesh", "ns_arrows", "ew_arrows", "direction_labels"],
      "description": "North-south traffic through gateway, east-west through mesh",
      "annotations": {
        "north_south": "External clients -> API Gateway -> Services",
        "east_west": "Service <-> Service via sidecars"
      },
      "enter_animation": {
        "type": "directional_arrows",
        "duration_ms": 2000
      }
    },
    "full_architecture": {
      "elements_visible": ["clients", "api_gateway", "service_mesh", "services", "all_connections"],
      "description": "Complete architecture with gateway and mesh working together",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}