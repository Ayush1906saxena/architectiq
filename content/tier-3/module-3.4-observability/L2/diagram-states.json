{
  "diagram": "metrics-dashboards",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "prometheus_architecture": {
      "elements_visible": ["prometheus_server", "service_a_endpoint", "service_b_endpoint", "scrape_arrows", "tsdb"],
      "description": "Prometheus pulling metrics from service /metrics endpoints into time-series DB",
      "enter_animation": {
        "type": "pull_flow",
        "duration_ms": 2000
      }
    },
    "counter_metric": {
      "elements_visible": ["counter_graph", "monotonic_line", "rate_overlay"],
      "description": "Monotonically increasing counter with rate-of-change overlay",
      "enter_animation": {
        "type": "draw_chart",
        "duration_ms": 2000
      }
    },
    "gauge_metric": {
      "elements_visible": ["gauge_graph", "fluctuating_line", "current_value"],
      "description": "Gauge metric going up and down showing current CPU/memory usage",
      "enter_animation": {
        "type": "draw_chart",
        "duration_ms": 2000
      }
    },
    "histogram_metric": {
      "elements_visible": ["histogram_bars", "bucket_labels", "bucket_counts"],
      "description": "Histogram with latency buckets filling up with observation counts",
      "enter_animation": {
        "type": "fill_bars",
        "duration_ms": 2000
      }
    },
    "percentile_comparison": {
      "elements_visible": ["distribution_curve", "average_line", "p50_line", "p99_line", "outlier_spike"],
      "description": "Latency distribution showing misleading average vs revealing percentiles",
      "enter_animation": {
        "type": "draw_distribution",
        "duration_ms": 2000
      }
    },
    "percentile_breakdown": {
      "elements_visible": ["p50_marker", "p95_marker", "p99_marker", "affected_users_count"],
      "description": "P50, P95, P99 marked on distribution with user count affected at each level",
      "enter_animation": {
        "type": "highlight_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "grafana_dashboard": {
      "elements_visible": ["dashboard_layout", "latency_panel", "error_rate_panel", "throughput_panel", "health_indicator"],
      "description": "Grafana dashboard with multiple panels showing key service metrics",
      "enter_animation": {
        "type": "populate_panels",
        "duration_ms": 2500
      }
    },
    "red_use_frameworks": {
      "elements_visible": ["red_card", "use_card", "rate_label", "errors_label", "duration_label", "utilization_label", "saturation_label"],
      "description": "RED (Rate, Errors, Duration) and USE (Utilization, Saturation, Errors) framework cards",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 300
      }
    },
    "alerting_strategy": {
      "elements_visible": ["symptom_alerts", "cause_alerts_crossed", "error_rate_threshold", "latency_threshold"],
      "description": "Symptom-based alerts (error rate, latency) preferred over cause-based (CPU)",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    }
  }
}