{
  "diagram": "observability",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "blind_system": {
      "elements_visible": ["system_box", "user_arrows", "question_marks"],
      "description": "A system box receiving user traffic but covered in question marks — no visibility into internals",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "logs_appear": {
      "elements_visible": ["system_box", "log_stream", "structured_log_example", "search_bar"],
      "description": "A scrolling log stream with structured JSON entries; a search bar filtering by request ID",
      "log_example": {
        "timestamp": "2024-03-15T10:23:45Z",
        "level": "ERROR",
        "service": "orders",
        "request_id": "abc-123",
        "message": "Payment declined",
        "user_id": 42
      },
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "metrics_dashboard": {
      "elements_visible": ["dashboard_panel", "counter_chart", "gauge_chart", "histogram_chart", "percentile_labels"],
      "description": "A dashboard with three chart types: counter (requests/sec line), gauge (CPU needle), histogram (latency distribution)",
      "charts": [
        { "type": "counter", "label": "Requests/sec", "value": 1250 },
        { "type": "gauge", "label": "CPU Usage", "value": "62%" },
        { "type": "histogram", "label": "Response Time", "percentiles": { "p50": "45ms", "p95": "120ms", "p99": "890ms" } }
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "trace_visualization": {
      "elements_visible": ["trace_waterfall", "span_api_gateway", "span_auth", "span_orders", "span_database", "duration_labels"],
      "description": "A waterfall trace diagram showing spans for API Gateway (5ms), Auth (12ms), Orders (45ms), Database (30ms)",
      "spans": [
        { "service": "API Gateway", "start_ms": 0, "duration_ms": 5 },
        { "service": "Auth Service", "start_ms": 5, "duration_ms": 12 },
        { "service": "Orders Service", "start_ms": 17, "duration_ms": 45 },
        { "service": "Database", "start_ms": 20, "duration_ms": 30 }
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 500
      }
    },
    "alert_fires": {
      "elements_visible": ["dashboard_panel", "alert_bell", "alert_rule", "notification_popup"],
      "description": "An alert rule triggers: error rate > 5%, firing a notification bell and popup",
      "alert_rule": {
        "condition": "error_rate > 5%",
        "window": "5 minutes",
        "severity": "critical"
      },
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "slo_budget": {
      "elements_visible": ["slo_target_bar", "sli_current", "error_budget_meter", "budget_label"],
      "description": "An SLO bar showing 99.9% target, current SLI at 99.85%, and an error budget meter showing remaining budget",
      "slo": {
        "target": "99.9%",
        "current_sli": "99.85%",
        "error_budget_remaining": "52%",
        "downtime_allowed": "43 min/month"
      },
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "full_observability": {
      "elements_visible": ["pillar_logs", "pillar_metrics", "pillar_traces", "slo_bar", "alert_icon", "system_healthy"],
      "description": "Three pillars side by side (Logs, Metrics, Traces) supporting an SLO bar, with a green healthy indicator",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    }
  }
}
