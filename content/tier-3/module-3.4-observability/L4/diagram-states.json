    "show_bad_vs_good_slis": {
      "elements_visible": ["bad_slis_column", "good_slis_column", "comparison_arrows"],
      "description": "Bad SLIs (avg latency, CPU, QPS) vs good SLIs (p99 latency, error rate, availability)",
      "enter_animation": { "type": "split_compare", "duration_ms": 2000 }
    },
    "show_nines_table": {
      "elements_visible": ["nines_table", "downtime_column", "cost_curve"],
      "description": "Table showing 99.9% to 99.999% with corresponding downtime and exponential cost curve",
      "enter_animation": { "type": "table_build", "duration_ms": 2500 }
    },
    "show_error_budget": {
      "elements_visible": ["budget_gauge", "consumed_portion", "remaining_portion", "action_labels"],
      "description": "Error budget gauge showing consumed vs remaining with actions for each zone",
      "enter_animation": { "type": "gauge_fill", "duration_ms": 2000 }
    },
    "show_burn_rate": {
      "elements_visible": ["time_axis", "budget_line", "burn_rate_1x", "burn_rate_10x", "alert_thresholds"],
      "description": "Burn rate chart showing 1x, 10x rates with alert thresholds at 14x and 6x",
      "enter_animation": { "type": "chart_draw", "duration_ms": 2500 }
    },
    "show_policy": {
      "elements_visible": ["budget_exhausted_actions", "budget_healthy_actions", "decision_flowchart"],
      "description": "Error budget policy flowchart: exhausted → freeze deploys vs healthy → ship fast",
      "enter_animation": { "type": "flowchart_build", "duration_ms": 2500 }
    },
    "show_google_sre": {
      "elements_visible": ["product_team", "sre_team", "slo_contract", "accountability_arrow"],
      "description": "Google SRE model: product sets SLO, SRE enforces, handback pager if budget repeatedly exhausted",
      "enter_animation": { "type": "contract_flow", "duration_ms": 2000 }
    },
    "show_summary": {
      "elements_visible": ["sli_box", "slo_box", "error_budget_box", "relationships"],
      "description": "Summary showing SLI→SLO→Error Budget relationship",
      "enter_animation": { "type": "zoom_out", "duration_ms": 2000 }
    }
  }
