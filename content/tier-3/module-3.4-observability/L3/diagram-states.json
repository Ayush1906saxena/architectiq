{
  "diagram": "distributed-tracing",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "trace_overview": {
      "elements_visible": ["api_gateway", "service_a", "service_b", "service_c", "database", "trace_line"],
      "description": "A request flowing through API gateway to multiple services, full trace highlighted",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "span_tree": {
      "elements_visible": ["root_span", "child_span_1", "child_span_2", "grandchild_span", "tree_lines"],
      "description": "Span tree with root span at top branching into child and grandchild spans",
      "enter_animation": {
        "type": "build_tree",
        "duration_ms": 2000
      }
    },
    "context_propagation": {
      "elements_visible": ["service_a", "service_b", "http_headers", "trace_id", "span_id", "header_arrow"],
      "description": "Trace context (trace ID, span ID) being passed in HTTP headers between services",
      "enter_animation": {
        "type": "header_propagation",
        "duration_ms": 2000
      }
    },
    "waterfall_view": {
      "elements_visible": ["waterfall_bars", "time_axis", "service_labels", "bottleneck_highlight"],
      "description": "Waterfall diagram showing spans as horizontal bars, widest bar highlighted as bottleneck",
      "enter_animation": {
        "type": "draw_waterfall",
        "duration_ms": 2500
      }
    },
    "tools_overview": {
      "elements_visible": ["jaeger_logo", "zipkin_logo", "opentelemetry_logo", "feature_labels"],
      "description": "Jaeger, Zipkin, and OpenTelemetry logos with key features",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "instrumentation": {
      "elements_visible": ["code_snippet", "otel_sdk", "auto_instrument_label", "exporter_arrow"],
      "description": "OpenTelemetry SDK auto-instrumenting HTTP and database calls",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "sampling_problem": {
      "elements_visible": ["request_flood", "storage_overflow", "volume_counter"],
      "description": "100K requests per second generating overwhelming trace data volumes",
      "enter_animation": {
        "type": "flood_animation",
        "duration_ms": 1500
      }
    },
    "sampling_strategies": {
      "elements_visible": ["head_sampling_flow", "tail_sampling_flow", "comparison_labels"],
      "description": "Head-based vs tail-based sampling shown side by side",
      "enter_animation": {
        "type": "split_comparison",
        "duration_ms": 2000
      }
    },
    "span_tags": {
      "elements_visible": ["span_with_tags", "user_id_tag", "order_id_tag", "search_box"],
      "description": "A span enriched with business context tags, searchable",
      "enter_animation": {
        "type": "tag_animation",
        "duration_ms": 1500
      }
    },
    "three_pillars": {
      "elements_visible": ["logs_pillar", "metrics_pillar", "traces_pillar", "observability_roof"],
      "description": "Three pillars of observability: logs, metrics, traces supporting the system",
      "enter_animation": {
        "type": "build_pillars",
        "duration_ms": 2000
      }
    }
  }
}