{
  "diagram": "message-queues",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "sync_coupling": {
      "elements_visible": ["service_a", "service_b", "sync_arrow", "waiting_spinner"],
      "description": "Service A sends a synchronous request to Service B and blocks while waiting",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 2000
      }
    },
    "sync_failure": {
      "elements_visible": ["service_a", "service_b_crashed", "timeout_indicator", "cascade_warning"],
      "description": "Service B crashes with red X; Service A shows timeout and failure cascade",
      "enter_animation": {
        "type": "crash_sequence",
        "duration_ms": 2500,
        "effects": ["red_flash", "shake", "timeout_counter"]
      }
    },
    "queue_appears": {
      "elements_visible": ["service_a", "message_queue", "service_b", "async_arrow"],
      "description": "A message queue box appears between Services A and B; A drops a message and continues",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "producer_consumer": {
      "elements_visible": ["producer_a", "message_queue", "consumer_b", "message_items", "producer_label", "consumer_label"],
      "description": "Producer pushes messages into queue, consumer pulls from queue at own pace",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "buffering_demo": {
      "elements_visible": ["producer_a", "message_queue", "consumer_b", "queue_depth_meter", "spike_indicator"],
      "description": "Traffic spike fills the queue; consumer drains at a steady rate, queue acts as buffer",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 400
      }
    },
    "pubsub_pattern": {
      "elements_visible": ["producer_a", "topic_box", "consumer_b", "consumer_c", "consumer_d", "fanout_arrows"],
      "description": "One producer publishes to a topic; multiple subscribers each receive a copy of every message",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "kafka_partitions": {
      "elements_visible": ["kafka_topic", "partition_0", "partition_1", "partition_2", "consumer_group", "offset_markers"],
      "description": "A Kafka topic split into three partitions; a consumer group with members assigned to partitions",
      "partitions": [
        { "id": "partition_0", "messages": ["msg_0", "msg_3", "msg_6"] },
        { "id": "partition_1", "messages": ["msg_1", "msg_4", "msg_7"] },
        { "id": "partition_2", "messages": ["msg_2", "msg_5", "msg_8"] }
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 500
      }
    }
  }
}
