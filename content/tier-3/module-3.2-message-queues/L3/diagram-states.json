{
  "diagram": "event-sourcing-cqrs",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "event_log": {
      "elements_visible": ["event_store", "event_1", "event_2", "event_3", "event_4", "append_arrow"],
      "description": "Immutable append-only event log with sequential events",
      "enter_animation": {
        "type": "append_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "replay_events": {
      "elements_visible": ["event_log", "replay_pointer", "state_accumulator", "running_balance"],
      "description": "Pointer replaying events one by one, accumulating state (balance)",
      "enter_animation": {
        "type": "replay_animation",
        "duration_ms": 3000
      }
    },
    "snapshots": {
      "elements_visible": ["event_log", "snapshot_marker", "recent_events_only", "state_result"],
      "description": "Snapshot checkpoint in the log, only recent events replayed after it",
      "enter_animation": {
        "type": "snapshot_animation",
        "duration_ms": 2000
      }
    },
    "benefits_overview": {
      "elements_visible": ["audit_trail_card", "debug_card", "reprocess_card", "history_card"],
      "description": "Four benefit cards: audit trail, debugging, reprocessing, historical queries",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "read_write_tension": {
      "elements_visible": ["write_pattern", "read_pattern", "conflict_indicator"],
      "description": "Write pattern (append) vs read pattern (complex queries) shown as conflicting",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "cqrs_architecture": {
      "elements_visible": ["command_side", "event_bus", "query_side", "write_store", "read_store"],
      "description": "CQRS split: command side with event store, query side with read-optimized store",
      "enter_animation": {
        "type": "split_animation",
        "duration_ms": 2000
      }
    },
    "projections": {
      "elements_visible": ["event_stream", "projection_sql", "projection_search", "projection_cache", "projection_arrows"],
      "description": "Events flowing to multiple projections: SQL table, search index, cache",
      "enter_animation": {
        "type": "fan_out",
        "duration_ms": 2000
      }
    },
    "eventual_lag": {
      "elements_visible": ["write_timestamp", "read_timestamp", "lag_indicator"],
      "description": "Small delay between event write and projection update",
      "enter_animation": {
        "type": "timeline_animation",
        "duration_ms": 1500
      }
    },
    "kafka_event_sourcing": {
      "elements_visible": ["kafka_cluster", "event_topics", "consumer_projections", "retention_label"],
      "description": "Kafka as event store with consumer groups powering projections",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}