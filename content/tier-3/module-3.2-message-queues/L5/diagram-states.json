{
  "diagram": "dead-letter-queues",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_retry_backoff": {
      "elements_visible": ["consumer", "message", "retry_timeline", "backoff_intervals"],
      "description": "Exponential backoff timeline: 1s, 2s, 4s, 8s between retries",
      "enter_animation": { "type": "timeline_grow", "duration_ms": 3000, "stagger_ms": 600 }
    },
    "show_jitter": {
      "elements_visible": ["without_jitter_burst", "with_jitter_spread", "comparison_label"],
      "description": "Side-by-side: thundering herd without jitter vs spread retries with jitter",
      "enter_animation": { "type": "split_comparison", "duration_ms": 2500 }
    },
    "show_sqs_dlq": {
      "elements_visible": ["source_queue", "consumer", "dlq", "receive_count", "max_receive_label"],
      "description": "SQS source queue with maxReceiveCount routing failed messages to DLQ",
      "enter_animation": { "type": "flow_with_counter", "duration_ms": 2500 }
    },
    "show_kafka_error_topic": {
      "elements_visible": ["source_topic", "consumer", "error_topic", "error_producer"],
      "description": "Kafka consumer publishing failed messages to error topic manually",
      "enter_animation": { "type": "dual_flow", "duration_ms": 2500 }
    },
    "show_replay": {
      "elements_visible": ["dlq", "replay_consumer", "source_queue", "staging_label"],
      "description": "DLQ replay: reading from DLQ and republishing to source queue via staging",
      "enter_animation": { "type": "reverse_flow", "duration_ms": 2500 }
    },
    "show_monitoring": {
      "elements_visible": ["dlq", "depth_metric", "alert_threshold", "pagerduty"],
      "description": "DLQ depth monitoring with alert threshold triggering PagerDuty",
      "enter_animation": { "type": "metric_rise", "duration_ms": 2000 }
    },
    "show_classification": {
      "elements_visible": ["dlq_messages", "transient_bucket", "permanent_bucket", "bug_bucket"],
      "description": "DLQ messages classified into transient, permanent, and bug-caused categories",
      "enter_animation": { "type": "sort_animation", "duration_ms": 2500 }
    },
    "show_full_architecture": {
      "elements_visible": ["source_queue", "consumer", "retry_logic", "dlq", "monitoring", "replay_tool"],
      "description": "Complete DLQ architecture with retry, monitoring, classification, and replay",
      "enter_animation": { "type": "assemble", "duration_ms": 3000 }
    }
  }
}