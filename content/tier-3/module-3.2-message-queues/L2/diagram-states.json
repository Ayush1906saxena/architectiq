{
  "diagram": "kafka-architecture",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "topic_partitions": {
      "elements_visible": ["topic_label", "partition_0", "partition_1", "partition_2", "offset_markers"],
      "description": "A topic split into three partitions, each showing ordered messages with offset numbers",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "partition_distribution": {
      "elements_visible": ["broker_1", "broker_2", "broker_3", "partition_assignments"],
      "description": "Six partitions distributed evenly across three brokers",
      "enter_animation": {
        "type": "distribute_animation",
        "duration_ms": 2000
      }
    },
    "replication_isr": {
      "elements_visible": ["leader_partition", "follower_1", "follower_2", "isr_label", "replication_arrows"],
      "description": "One leader partition with two followers, ISR set highlighted",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "isr_failover": {
      "elements_visible": ["leader_crashed", "isr_members", "new_leader_elected"],
      "description": "Leader crashes, new leader elected from ISR",
      "enter_animation": {
        "type": "crash_and_elect",
        "duration_ms": 2500
      }
    },
    "consumer_groups": {
      "elements_visible": ["partitions_row", "consumer_group", "consumer_1", "consumer_2", "consumer_3", "assignment_arrows"],
      "description": "Three consumers in a group, each assigned two of six partitions",
      "enter_animation": {
        "type": "assign_animation",
        "duration_ms": 2000
      }
    },
    "offset_tracking": {
      "elements_visible": ["partition_log", "consumer_pointer", "committed_offset", "current_offset"],
      "description": "Consumer reading through a partition, committed offset marker trailing behind",
      "enter_animation": {
        "type": "scroll_animation",
        "duration_ms": 2000
      }
    },
    "retention_policies": {
      "elements_visible": ["time_based_retention", "size_based_retention", "compaction_retention", "retention_window"],
      "description": "Three retention strategies shown with their data lifecycle",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "log_compaction": {
      "elements_visible": ["full_log", "compacted_log", "key_latest_values"],
      "description": "Before and after log compaction — old values for same key removed",
      "enter_animation": {
        "type": "compact_animation",
        "duration_ms": 2000
      }
    },
    "ordering_guarantee": {
      "elements_visible": ["partitions_with_keys", "user_id_hash", "same_partition_arrow"],
      "description": "User ID hashed to route all events for same user to same partition",
      "enter_animation": {
        "type": "hash_route_animation",
        "duration_ms": 1500
      }
    }
  }
}