{
  "diagram": "cap-theorem",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "three_nodes": {
      "elements_visible": ["node_a", "node_b", "node_c", "connection_ab", "connection_bc", "connection_ac"],
      "description": "Three database nodes in a triangle with network connections between them",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "normal_operation": {
      "elements_visible": ["node_a", "node_b", "node_c", "connection_ab", "connection_bc", "connection_ac", "write_flow", "replication_arrows"],
      "description": "Write to node A replicates to B and C; reads work from any node",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 3000
      }
    },
    "partition_appears": {
      "elements_visible": ["node_a", "node_b", "node_c", "connection_bc", "connection_ac", "partition_line"],
      "description": "Network link between A and B breaks; red partition line appears",
      "partition": { "between": ["node_a", "node_b"] },
      "enter_animation": {
        "type": "partition_break",
        "duration_ms": 1500,
        "effects": ["red_line", "connection_snap", "lightning"]
      }
    },
    "choose_cp": {
      "elements_visible": ["node_a", "node_b", "node_c", "partition_line", "write_rejected_indicator", "consistency_badge"],
      "description": "Node A rejects the write to maintain consistency; CP badge shown",
      "enter_animation": {
        "type": "reject_sequence",
        "duration_ms": 2000,
        "effects": ["red_x_on_write", "badge_appear"]
      }
    },
    "choose_ap": {
      "elements_visible": ["node_a", "node_b", "node_c", "partition_line", "write_accepted_indicator", "divergence_warning"],
      "description": "Node A accepts the write; nodes now have different data; AP badge shown",
      "enter_animation": {
        "type": "accept_sequence",
        "duration_ms": 2000,
        "effects": ["green_check_on_write", "divergence_highlight"]
      }
    },
    "real_world_examples": {
      "elements_visible": ["cap_triangle", "ap_column", "cp_column", "example_labels"],
      "description": "CAP triangle with AP examples (DynamoDB, Cassandra) and CP examples (Spanner, etcd)",
      "examples": {
        "AP": ["DynamoDB", "Cassandra", "CouchDB"],
        "CP": ["Google Spanner", "etcd", "HBase"]
      },
      "enter_animation": {
        "type": "columns_appear",
        "duration_ms": 2500,
        "stagger_ms": 300
      }
    },
    "pacelc_extension": {
      "elements_visible": ["pacelc_diagram", "pa_el_label", "pc_ec_label", "system_classifications"],
      "description": "PACELC framework: partition (A vs C) + else (L vs C) with system classifications",
      "classifications": {
        "DynamoDB": "PA/EL",
        "Cassandra": "PA/EL",
        "Spanner": "PC/EC",
        "MongoDB": "PA/EC"
      },
      "enter_animation": {
        "type": "diagram_morph",
        "duration_ms": 2500
      }
    }
  }
}