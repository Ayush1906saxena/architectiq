        "type": "role_reveal",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "prepare_phase": {
      "elements_visible": ["proposer", "acceptor_1", "acceptor_2", "acceptor_3", "prepare_messages", "promise_responses"],
