        "duration_ms": 1500
      }
    },
    "dueling_proposers": {
      "elements_visible": ["proposer_a", "proposer_b", "prepare_1", "prepare_2", "prepare_3", "invalidation_arrows"],
      "description": "Two proposers alternately invalidating each other's prepare phases",
      "enter_animation": {
        "type": "ping_pong",
        "duration_ms": 3000,
        "stagger_ms": 500
      }
    },
    "implementation_gaps": {
      "elements_visible": ["paxos_core", "gap_leader_election", "gap_log_compaction", "gap_membership", "question_marks"],
