        "type": "message_exchange",
        "duration_ms": 2000
      }
    },
    "value_decided": {
      "elements_visible": ["acceptor_1_accepted", "acceptor_2_accepted", "acceptor_3_accepted", "decided_badge", "learner_notification"],
