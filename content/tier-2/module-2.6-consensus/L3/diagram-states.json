{
  "diagram": "raft-consensus",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "node_states": {
      "elements_visible": ["follower_state", "candidate_state", "leader_state", "transition_arrows", "term_counter"],
      "description": "Three Raft states with transition arrows and term counter",
      "enter_animation": {
        "type": "state_machine_reveal",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "leader_election": {
      "elements_visible": ["node_a", "node_b", "node_c", "timeout_bars", "request_vote_arrows", "vote_responses"],
      "description": "Node A times out first, sends RequestVote, receives majority votes",
      "enter_animation": {
        "type": "election_sequence",
        "duration_ms": 3000
      }
    },
    "split_vote": {
      "elements_visible": ["candidate_a", "candidate_b", "split_votes", "new_random_timeouts", "round_2_winner"],
      "description": "Two simultaneous candidates, neither gets majority, retry with new timeouts",
      "enter_animation": {
        "type": "split_then_resolve",
        "duration_ms": 2500
      }
    },
    "log_replication": {
      "elements_visible": ["leader_log", "follower_1_log", "follower_2_log", "append_entries_arrows", "ack_arrows"],
      "description": "Leader sends AppendEntries to followers, receives acknowledgments",
      "enter_animation": {
        "type": "replication_flow",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    },
    "commit_index": {
      "elements_visible": ["log_entries", "commit_index_marker", "majority_ack_indicator", "apply_arrow"],
      "description": "Commit index advancing as majority acknowledges, entries applied to state machine",
      "enter_animation": {
        "type": "index_advance",
        "duration_ms": 2000
      }
    },
    "safety_check": {
      "elements_visible": ["candidate_log", "voter_log", "comparison_overlay", "accept_reject_result"],
      "description": "Voter comparing its log to candidate's log, accepting only if candidate is up-to-date",
      "enter_animation": {
        "type": "log_comparison",
        "duration_ms": 2000
      }
    },
    "raft_vs_paxos": {
      "elements_visible": ["raft_column", "paxos_column", "comparison_rows"],
      "description": "Side-by-side comparison table: Raft vs Paxos on key dimensions",
      "enter_animation": {
        "type": "table_reveal",
        "duration_ms": 1500
      }
    },
    "etcd_implementation": {
      "elements_visible": ["kubernetes_api_server", "etcd_cluster", "raft_layer", "state_machine"],
      "description": "Kubernetes API server backed by etcd cluster running Raft consensus",
      "enter_animation": {
        "type": "architecture_reveal",
        "duration_ms": 2000
      }
    },
    "raft_ecosystem": {
      "elements_visible": ["etcd_icon", "cockroachdb_icon", "tikv_icon", "consul_icon", "raft_center"],
      "description": "Raft at center with production implementations around it",
      "enter_animation": {
        "type": "radial_reveal",
        "duration_ms": 1500,
        "stagger_ms": 300
      }
    }
  }
}