{
  "diagram": "partition-strategies",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "range_based": {
      "elements_visible": ["partition_a", "partition_b", "partition_c", "range_labels", "key_space_bar"],
      "description": "Three partitions with contiguous key ranges: A-F, G-M, N-Z",
      "enter_animation": {
        "type": "range_split",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "range_hotspot": {
      "elements_visible": ["partitions", "timestamp_writes", "hot_partition_glow", "cold_partitions"],
      "description": "All timestamp-keyed writes hitting the last partition, others idle",
      "enter_animation": {
        "type": "hot_concentrate",
        "duration_ms": 2000
      }
    },
    "hash_based": {
      "elements_visible": ["hash_function", "key_inputs", "hash_outputs", "partitions_uniform"],
      "description": "Keys passing through hash function, distributing uniformly across partitions",
      "enter_animation": {
        "type": "hash_distribute",
        "duration_ms": 2500,
        "stagger_ms": 300
      }
    },
    "hash_range_loss": {
      "elements_visible": ["all_partitions", "scatter_arrows", "range_query_label", "latency_indicator"],
      "description": "Range query scattering to all partitions with high latency indicator",
      "enter_animation": {
        "type": "scatter_blast",
        "duration_ms": 2000
      }
    },
    "compound_keys": {
      "elements_visible": ["partition_key_hash", "clustering_key_sort", "within_partition_range", "example_query"],
      "description": "Compound key: hash part determines partition, sort part enables range scan within",
      "enter_animation": {
        "type": "two_part_reveal",
        "duration_ms": 2000
      }
    },
    "directory_based": {
      "elements_visible": ["directory_service", "lookup_arrows", "data_nodes", "mapping_table"],
      "description": "Central directory service mapping keys to arbitrary data nodes",
      "enter_animation": {
        "type": "lookup_flow",
        "duration_ms": 2000
      }
    },
    "hot_detection": {
      "elements_visible": ["dashboard", "partition_metrics", "hot_alert", "threshold_line"],
      "description": "Monitoring dashboard with per-partition metrics, one exceeding threshold",
      "enter_animation": {
        "type": "dashboard_reveal",
        "duration_ms": 1500
      }
    },
    "comparison_matrix": {
      "elements_visible": ["matrix_grid", "row_range", "row_hash", "row_directory", "col_range_scan", "col_distribution", "col_flexibility"],
      "description": "Three-row comparison matrix across range scan, distribution, and flexibility",
      "enter_animation": {
        "type": "grid_fill",
        "duration_ms": 2000
      }
    },
    "summary": {
      "elements_visible": ["range_icon", "hash_icon", "directory_icon", "selection_arrow"],
      "description": "Three strategy icons with decision flow arrow",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}