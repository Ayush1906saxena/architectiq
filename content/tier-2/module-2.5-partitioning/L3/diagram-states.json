      "description": "Reader fans out to all salt partitions in parallel, merges results",
      "enter_animation": {
        "type": "fan_out_gather",
        "duration_ms": 2000
      }
    },
    "slack_channels": {
      "elements_visible": ["small_channel", "medium_channel", "huge_channel", "member_count_labels", "load_comparison"],
      "description": "Three Slack channels of vastly different sizes with load disparity",
      "enter_animation": {
        "type": "size_comparison",
        "duration_ms": 1500
      }
