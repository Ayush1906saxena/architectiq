      "enter_animation": {
        "type": "fan_out_and_collect",
        "duration_ms": 2500
      }
    },
    "tail_latency": {
      "elements_visible": ["latency_histogram", "p99_line", "aggregate_p99_line", "hedged_request_arrow"],
      "description": "Per-partition p99 vs aggregate p99 with hedged request strategy",
      "enter_animation": {
        "type": "histogram_build",
        "duration_ms": 2000
      }
    },
    "local_index": {
      "elements_visible": ["partition_1_with_index", "partition_2_with_index", "partition_3_with_index", "scatter_query"],
      "description": "Each partition maintains its own secondary index, query must scatter",
      "enter_animation": {
        "type": "per_partition_reveal",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "global_index": {
      "elements_visible": ["data_partitions", "global_index_partitions", "single_lookup_arrow", "write_dual_path"],
      "description": "Global index partitioned separately, single-partition reads but dual-write path",
      "enter_animation": {
        "type": "dual_store_reveal",
        "duration_ms": 2000
      }
    },
    "denormalization": {
      "elements_visible": ["write_event", "table_by_user", "table_by_time", "table_by_product", "duplicate_arrows"],
      "description": "Same data written to multiple tables shaped for different query patterns",
      "enter_animation": {
        "type": "duplicate_flow",
        "duration_ms": 2000,
        "stagger_ms": 300
      }
    },
    "vitess_architecture": {
      "elements_visible": ["application", "vtgate_proxy", "mysql_shard_1", "mysql_shard_2", "mysql_shard_3", "routing_logic"],
      "description": "Vitess vtgate sitting between app and MySQL shards, routing queries",
      "enter_animation": {
        "type": "architecture_reveal",
        "duration_ms": 2000
      }
    },
    "vitess_limitations": {
      "elements_visible": ["cross_shard_join", "two_phase_commit", "memory_merge", "cost_indicators"],
      "description": "Three Vitess limitations: expensive joins, 2PC latency, in-memory merge",
      "enter_animation": {
        "type": "limitation_cards",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "cqrs_pattern": {
      "elements_visible": ["write_store", "async_projection", "read_store", "query_path", "command_path"],
