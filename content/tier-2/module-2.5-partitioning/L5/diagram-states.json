{
  "diagram": "cross-partition-queries",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "scatter_gather": {
      "elements_visible": ["coordinator", "partition_1", "partition_2", "partition_n", "fan_out_arrows", "merge_result"],
