{
  "diagram": "data-partitioning",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "single_vs_partitioned": {
      "elements_visible": ["single_big_db", "arrow", "shard_1", "shard_2", "shard_3"],
      "description": "One large database splitting into three smaller shards",
      "enter_animation": {
        "type": "split_animation",
        "duration_ms": 1500
      }
    },
    "range_partitioning": {
      "elements_visible": ["shard_a_g", "shard_h_n", "shard_o_z", "range_labels"],
      "description": "Three shards with alphabetical key ranges labeled A-G, H-N, O-Z",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "hotspot_range": {
      "elements_visible": ["shard_a_g", "shard_h_n", "shard_o_z", "hotspot_glow_o_z"],
      "description": "Shard O-Z glowing red as a hotspot due to uneven key distribution",
      "enter_animation": {
        "type": "glow_animation",
        "duration_ms": 1200
      }
    },
    "hash_partitioning": {
      "elements_visible": ["hash_function", "shard_0", "shard_1", "shard_2", "scattered_keys"],
      "description": "Keys passing through a hash function and scattering uniformly across shards",
      "enter_animation": {
        "type": "scatter_animation",
        "duration_ms": 2000
      }
    },
    "directory_partitioning": {
      "elements_visible": ["directory_service", "shard_1", "shard_2", "shard_3", "lookup_arrows"],
      "description": "Central directory service with lookup arrows pointing to the correct shard for each key",
      "enter_animation": {
        "type": "lookup_flow",
        "duration_ms": 1500
      }
    },
    "directory_risk": {
      "elements_visible": ["directory_service_crashed", "shard_1", "shard_2", "shard_3", "blocked_arrows"],
      "description": "Directory service down, all shard lookups blocked with red X marks",
      "enter_animation": {
        "type": "crash_sequence",
        "duration_ms": 1500,
        "effects": ["red_flash", "blocked"]
      }
    },
    "hotspot_solutions": {
      "elements_visible": ["hot_key", "sub_partitions", "random_suffix_label"],
      "description": "Hot key being split across sub-partitions using random suffix strategy",
      "enter_animation": {
        "type": "split_and_distribute",
        "duration_ms": 1500
      }
    },
    "scatter_gather": {
      "elements_visible": ["query_origin", "scatter_arrows", "shard_1", "shard_2", "shard_3", "gather_arrows", "merged_result"],
      "description": "Cross-partition query: scatter to all shards, gather and merge results",
      "enter_animation": {
        "type": "scatter_gather_flow",
        "duration_ms": 2500
      }
    },
    "full_picture": {
      "elements_visible": ["range_icon", "hash_icon", "directory_icon", "tradeoff_labels"],
      "description": "Summary view of all three partitioning strategies with their key tradeoffs",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}
