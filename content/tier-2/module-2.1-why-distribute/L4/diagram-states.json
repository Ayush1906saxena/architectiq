{
  "diagram": "horizontal-vs-vertical",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "single_server_specs": {
      "elements_visible": ["server_large", "spec_label_cpu", "spec_label_ram", "cost_label"],
