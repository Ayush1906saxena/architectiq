      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 300
      }
    },
    "stateful_complexity": {
      "elements_visible": ["db_shard_1", "db_shard_2", "db_shard_3", "cross_shard_arrows", "complexity_label"],
      "description": "Database shards with cross-shard query arrows showing complexity",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "instagram_growth": {
      "elements_visible": ["timeline", "point_2010", "point_2012", "server_count_label", "user_count_label"],
      "description": "Instagram timeline from 3 servers to 1000+ servers, 0 to 40M users",
      "enter_animation": {
        "type": "timeline_reveal",
        "duration_ms": 3000
      }
    },
    "instagram_architecture": {
      "elements_visible": ["django_tier", "postgres_tier", "s3_tier", "decision_labels"],
