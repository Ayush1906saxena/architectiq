        "type": "draw_line",
        "duration_ms": 2000
      }
    },
    "horizontal_fleet": {
      "elements_visible": ["server_small_1", "server_small_2", "server_small_3", "server_small_4", "server_small_5", "server_small_6", "load_balancer", "cost_label_fleet"],
      "description": "Sixteen small servers behind a load balancer at same total cost",
      "enter_animation": {
        "type": "fan_out",
        "duration_ms": 2000,
        "stagger_ms": 100
      }
    },
    "cost_crossover_chart": {
      "elements_visible": ["chart_axes", "vertical_cost_line", "horizontal_cost_line", "crossover_point"],
      "description": "Chart showing cost-per-compute crossing over at 4-8 cores",
      "enter_animation": {
        "type": "draw_line",
        "duration_ms": 2500
      }
    },
    "stateless_scaling": {
      "elements_visible": ["lb", "app_server_1", "app_server_2", "app_server_3", "app_server_new"],
