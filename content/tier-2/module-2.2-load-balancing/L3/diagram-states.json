{
  "diagram": "l4-vs-l7-lb",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "osi_layers": {
      "elements_visible": ["osi_stack", "l4_highlight", "l7_highlight"],
      "description": "OSI model with Layer 4 (Transport) and Layer 7 (Application) highlighted",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 200
      }
    },
    "l4_routing": {
      "elements_visible": ["l4_lb", "tcp_packet", "backend_servers", "ip_port_labels"],
      "description": "L4 load balancer forwarding TCP connections based on IP and port only",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "l4_performance": {
      "elements_visible": ["l4_lb", "throughput_counter", "latency_gauge"],
      "description": "Performance metrics showing millions of connections per second",
      "enter_animation": {
        "type": "counter_animation",
        "duration_ms": 1500
      }
    },
    "l7_routing": {
      "elements_visible": ["l7_lb", "http_request_expanded", "headers_panel", "url_panel"],
      "description": "L7 load balancer inspecting HTTP headers, URLs, and cookies",
      "enter_animation": {
        "type": "expand_sequence",
        "duration_ms": 2000
      }
    },
    "content_based_routing": {
      "elements_visible": ["l7_lb", "api_cluster", "cdn_origin", "admin_cluster", "path_arrows"],
      "description": "Requests routed to different backends based on URL path",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 2500,
        "stagger_ms": 600
      }
    },
    "tls_termination": {
      "elements_visible": ["client", "l7_lb", "backend", "encrypted_segment", "decrypted_segment"],
      "description": "TLS terminated at load balancer, plaintext forwarded to backend",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 2000
      }
    },
    "tls_security_tradeoff": {
      "elements_visible": ["client", "l7_lb", "backend", "plaintext_warning", "security_shield"],
      "description": "Highlighting plaintext segment between LB and backend as security concern",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "l4_use_cases": {
      "elements_visible": ["l4_lb", "database_icon", "mq_icon", "tcp_services_label"],
      "description": "L4 use cases: databases, message brokers, non-HTTP protocols",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "l7_use_cases": {
      "elements_visible": ["l7_lb", "ab_test_icon", "canary_icon", "auth_icon", "rate_limit_icon"],
      "description": "L7 use cases: A/B testing, canary deployments, auth, rate limiting",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "combined_architecture": {
      "elements_visible": ["l4_edge", "l7_cluster", "backend_services", "two_tier_arrows"],
      "description": "Two-tier architecture: L4 at edge distributing to multiple L7 load balancers",
      "enter_animation": {
        "type": "build_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    }
  }
}