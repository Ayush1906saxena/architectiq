{
  "diagram": "lb-algorithms",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "round_robin_view": {
      "elements_visible": ["load_balancer", "server_a", "server_b", "server_c", "request_queue"],
      "description": "Load balancer cycling requests 1-2-3 through servers A-B-C in order",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "weighted_servers": {
      "elements_visible": ["load_balancer", "server_a_large", "server_b_small", "capacity_labels"],
      "description": "Two servers shown with different sizes representing capacity difference",
      "enter_animation": {
        "type": "morph",
        "duration_ms": 1200
      }
    },
    "weighted_distribution": {
      "elements_visible": ["load_balancer", "server_a_large", "server_b_small", "weight_labels", "request_flow"],
      "description": "Requests flowing with 4:1 ratio to large vs small server",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "least_connections_view": {
      "elements_visible": ["load_balancer", "server_a", "server_b", "server_c", "connection_counters"],
      "description": "Servers with connection count badges, new request routed to lowest count",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "least_conn_adaptive": {
      "elements_visible": ["load_balancer", "server_a_slow", "server_b", "server_c", "connection_counters", "backpressure_indicator"],
      "description": "Server A slowing down with rising connection count, traffic shifts to B and C",
      "enter_animation": {
        "type": "transition",
        "duration_ms": 2000
      }
    },
    "ip_hash_view": {
      "elements_visible": ["load_balancer", "server_a", "server_b", "server_c", "client_ips", "hash_arrows"],
      "description": "Client IPs being hashed to deterministic server assignments",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "ip_hash_failure": {
      "elements_visible": ["load_balancer", "server_a", "server_b_crashed", "server_c", "lost_sessions"],
      "description": "Server B crashes, clients pinned to it lose sessions",
      "enter_animation": {
        "type": "crash_sequence",
        "duration_ms": 1500,
        "effects": ["red_flash", "fade_out"]
      }
    },
    "two_choices_view": {
      "elements_visible": ["load_balancer", "all_servers", "two_highlighted", "comparison_arrow"],
      "description": "Two random servers highlighted, request goes to the one with fewer connections",
      "enter_animation": {
        "type": "highlight_sequence",
        "duration_ms": 2000
      }
    },
    "two_choices_comparison": {
      "elements_visible": ["load_distribution_chart", "random_curve", "two_choices_curve"],
      "description": "Bar chart comparing load variance between pure random and two-random-choices",
      "enter_animation": {
        "type": "draw_chart",
        "duration_ms": 2000
      }
    },
    "algorithm_comparison": {
      "elements_visible": ["comparison_table"],
      "description": "Summary table of all algorithms with use cases",
      "columns": ["Algorithm", "Best For", "Trade-off"],
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}