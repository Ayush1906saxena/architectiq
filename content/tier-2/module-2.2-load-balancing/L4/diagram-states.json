{
  "diagram": "health-checks-circuit-breakers",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "active_checks": {
      "elements_visible": ["load_balancer", "backend_1", "backend_2", "backend_3", "probe_arrows", "health_status_icons"],
      "description": "Load balancer sending periodic health probes to three backends",
      "enter_animation": {
        "type": "pulse_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "passive_checks": {
      "elements_visible": ["load_balancer", "backend_1", "backend_2", "backend_3", "real_traffic_arrows", "error_counter"],
      "description": "Real user traffic flowing through with error counters on each backend",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "cascade_failure": {
      "elements_visible": ["service_a", "service_b_down", "thread_pool", "timeout_indicators", "cascade_arrows"],
      "description": "Service A hanging on calls to dead Service B, thread pool filling up",
      "enter_animation": {
        "type": "cascade_sequence",
        "duration_ms": 3000,
        "effects": ["fill_threads", "timeout_flash"]
      }
    },
    "circuit_states": {
      "elements_visible": ["state_closed", "state_open", "state_half_open", "transition_arrows", "threshold_labels"],
      "description": "Three circuit breaker states with transition conditions labeled",
      "enter_animation": {
        "type": "state_machine_reveal",
        "duration_ms": 2000,
        "stagger_ms": 600
      }
    },
    "half_open_detail": {
      "elements_visible": ["state_half_open_detail", "test_request", "success_path", "failure_path"],
      "description": "Half-open state zoomed in showing single test request branching to success or failure",
      "enter_animation": {
        "type": "zoom_in",
        "duration_ms": 1000
      }
    },
    "hystrix_wrapper": {
      "elements_visible": ["hystrix_command", "timeout_config", "thread_pool", "fallback_path", "netflix_logo"],
      "description": "HystrixCommand wrapping an external call with timeout and fallback",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "resilience4j_chain": {
      "elements_visible": ["circuit_breaker_decorator", "rate_limiter_decorator", "retry_decorator", "bulkhead_decorator", "chain_arrows"],
      "description": "Resilience4j composable decorator chain stacked around a service call",
      "enter_animation": {
        "type": "stack_build",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "bulkhead_isolation": {
      "elements_visible": ["ship_hull", "compartment_payment", "compartment_search", "compartment_auth", "breach_indicator"],
      "description": "Ship hull with watertight compartments, one breached but others isolated",
      "enter_animation": {
        "type": "breach_and_contain",
        "duration_ms": 2500
      }
    },
    "netflix_incident": {
      "elements_visible": ["netflix_arch", "overloaded_api", "cascade_spread", "fix_bulkheads"],
      "description": "Netflix 2012 cascading failure spreading then being contained by bulkheads",
      "enter_animation": {
        "type": "before_after",
        "duration_ms": 3000
      }
    },
    "resilience_trifecta": {
      "elements_visible": ["health_check_icon", "circuit_breaker_icon", "bulkhead_icon", "trifecta_label"],
      "description": "Three resilience patterns shown as a unified trifecta",
      "enter_animation": {
        "type": "triangle_reveal",
        "duration_ms": 1500
      }
    }
  }
}