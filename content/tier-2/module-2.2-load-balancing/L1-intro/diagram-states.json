{
  "diagram": "load-balancing",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "single_server": {
      "elements_visible": ["server_a", "client_group"],
      "description": "A single server with client arrows pointing to it",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "clients_overwhelming": {
      "elements_visible": ["server_a", "client_flood", "overload_indicator"],
      "description": "Hundreds of client requests overwhelming the single server, server turns red",
      "enter_animation": {
        "type": "flood_sequence",
        "duration_ms": 3000,
        "effects": ["request_burst", "server_glow_red"]
      }
    },
    "lb_appears": {
      "elements_visible": ["load_balancer", "server_a", "server_b", "server_c", "client_group"],
      "description": "Load balancer appears between clients and three servers",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "round_robin_flow": {
      "elements_visible": ["load_balancer", "server_a", "server_b", "server_c", "rr_packets"],
      "description": "Packets cycling round-robin: A, B, C, A",
      "packets": [
        { "id": "req_1", "label": "Req 1", "target": "server_a" },
        { "id": "req_2", "label": "Req 2", "target": "server_b" },
        { "id": "req_3", "label": "Req 3", "target": "server_c" },
        { "id": "req_4", "label": "Req 4", "target": "server_a" }
      ],
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 4000,
        "stagger_ms": 900
      }
    },
    "weighted_flow": {
      "elements_visible": ["load_balancer", "server_a", "server_b", "server_c", "weight_labels", "weighted_packets"],
      "description": "Server A gets 2x traffic, thicker arrow and weight labels shown",
      "weights": { "server_a": 2, "server_b": 1, "server_c": 1 },
      "enter_animation": {
        "type": "weighted_flow",
        "duration_ms": 3000
      }
    },
    "health_check": {
      "elements_visible": ["load_balancer", "server_a", "server_b", "server_c", "health_pings", "status_badges"],
      "description": "Load balancer pinging each server with green checkmarks",
      "enter_animation": {
        "type": "ping_sequence",
        "duration_ms": 2400,
        "stagger_ms": 600
      }
    },
    "server_failure_handled": {
      "elements_visible": ["load_balancer", "server_a", "server_b_crashed", "server_c", "redistributed_arrows"],
      "description": "Server B crashes and is removed; traffic reroutes to A and C",
      "crash_target": "server_b",
      "enter_animation": {
        "type": "crash_and_reroute",
        "duration_ms": 3000,
        "effects": ["red_flash", "shake", "fade_out", "reroute_arrows"]
      }
    }
  }
}