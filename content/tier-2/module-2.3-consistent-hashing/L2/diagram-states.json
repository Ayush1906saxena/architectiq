{
  "diagram": "hash-ring",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "ring_outline": {
      "elements_visible": ["hash_ring", "zero_marker", "max_marker"],
      "description": "A number line bending into a circle, forming the hash ring",
      "enter_animation": {
        "type": "morph_line_to_ring",
        "duration_ms": 2000
      }
    },
    "servers_on_ring": {
      "elements_visible": ["hash_ring", "server_a_node", "server_b_node", "server_c_node"],
      "description": "Three servers placed at their hashed positions on the ring",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "data_placement": {
      "elements_visible": ["hash_ring", "server_a_node", "server_b_node", "server_c_node", "data_key", "clockwise_arrow"],
      "description": "A data key hashed onto the ring, arrow walking clockwise to nearest server",
      "enter_animation": {
        "type": "walk_clockwise",
        "duration_ms": 2000
      }
    },
    "multiple_keys_placed": {
      "elements_visible": ["hash_ring", "server_a_node", "server_b_node", "server_c_node", "key_alpha", "key_beta", "key_gamma", "ownership_arcs"],
      "description": "Multiple keys placed on ring with colored arcs showing server ownership zones",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "add_server": {
      "elements_visible": ["hash_ring", "server_a_node", "server_b_node", "server_c_node", "server_d_node", "migrated_keys_highlight", "affected_arc"],
      "description": "Server D inserted between A and B, only small arc of keys migrates",
      "enter_animation": {
        "type": "insert_and_migrate",
        "duration_ms": 2500
      }
    },
    "movement_comparison": {
      "elements_visible": ["comparison_bar", "modulo_75_percent", "consistent_25_percent"],
      "description": "Side-by-side comparison: 75% data movement (modulo) vs 25% (consistent hashing)",
      "enter_animation": {
        "type": "bar_chart_grow",
        "duration_ms": 1500
      }
    },
    "remove_server": {
      "elements_visible": ["hash_ring", "server_a_node", "server_b_fading", "server_c_node", "migration_arrows"],
      "description": "Server B removed, its keys migrate clockwise to server C",
      "enter_animation": {
        "type": "remove_and_migrate",
        "duration_ms": 2000
      }
    },
    "real_world_examples": {
      "elements_visible": ["hash_ring", "dynamo_logo", "cassandra_logo", "akamai_logo"],
      "description": "Logos of DynamoDB, Cassandra, and Akamai overlaid on the ring",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "uneven_distribution": {
      "elements_visible": ["hash_ring", "server_a_node", "server_b_node", "server_c_node", "uneven_arcs", "percentage_labels"],
      "description": "Ring showing uneven arc sizes — one server owns 60%, another only 10%",
      "enter_animation": {
        "type": "highlight_arcs",
        "duration_ms": 1500
      }
    }
  }
}