{
  "diagram": "bounded-loads",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "load_imbalance": {
      "elements_visible": ["hash_ring", "node_a", "node_b", "node_c", "node_d", "node_e", "load_bars"],
      "description": "Five nodes on ring with wildly uneven load bars: 40%, 5%, 20%, 25%, 10%",
      "load_distribution": {
        "node_a": 0.40,
        "node_b": 0.05,
        "node_c": 0.20,
        "node_d": 0.25,
        "node_e": 0.10
      },
      "enter_animation": {
        "type": "bar_chart_grow",
        "duration_ms": 2000
      }
    },
    "bounded_rule": {
      "elements_visible": ["hash_ring", "nodes", "capacity_line", "epsilon_label", "overflow_arrow"],
      "description": "Ring with a horizontal capacity line at 1+epsilon times average, overflow arrow to next node",
      "enter_animation": {
        "type": "draw_line",
        "duration_ms": 1500
      }
    },
    "epsilon_tradeoff": {
      "elements_visible": ["slider", "balance_axis", "consistency_axis", "sweet_spot_marker"],
      "description": "Slider showing epsilon from 0 to 1 with balance vs consistency tradeoff",
      "enter_animation": {
        "type": "slider_reveal",
        "duration_ms": 1500
      }
    },
    "power_of_two": {
      "elements_visible": ["node_choice_1", "node_choice_2", "load_comparison", "selection_arrow"],
      "description": "Two candidate nodes compared side by side, less-loaded one selected",
      "enter_animation": {
        "type": "comparison_reveal",
        "duration_ms": 1500
      }
    },
    "combined_approach": {
      "elements_visible": ["hash_ring", "primary_node_full", "overflow_to_next", "capacity_indicators"],
      "description": "Ring hashing to overloaded primary, spilling clockwise to next available node",
      "enter_animation": {
        "type": "redirect_flow",
        "duration_ms": 2000
      }
    },
    "envoy_implementation": {
      "elements_visible": ["envoy_proxy", "ring_hash_config", "backend_servers", "load_factor_indicator"],
      "description": "Envoy proxy with ring hash LB config showing bounded load enforcement",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "state_tracking": {
      "elements_visible": ["proxy_fleet", "shared_load_counters", "approximate_label"],
      "description": "Fleet of proxies with approximate distributed load counters",
      "enter_animation": {
        "type": "fan_out",
        "duration_ms": 1500
      }
    },
    "use_cases": {
      "elements_visible": ["cdn_cache_icon", "sticky_session_icon", "video_cache_icon"],
      "description": "Use case icons: CDN caching, sticky sessions, video cache tier",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "summary": {
      "elements_visible": ["ring_with_bounds", "guarantee_badge"],
      "description": "Clean ring with bounded load guarantee badge",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}