{
  "diagram": "mod-hashing",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "four_servers_visible": {
      "elements_visible": ["server_0", "server_1", "server_2", "server_3"],
      "description": "Four servers appear in a row",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "show_mod_formula": {
      "elements_visible": ["server_0", "server_1", "server_2", "server_3", "formula_overlay"],
      "description": "Show the modulo formula: ID % 4 = server",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 800
      }
    },
    "show_mod_routing": {
      "elements_visible": ["server_0", "server_1", "server_2", "server_3", "data_packets"],
      "description": "Animate data packets flowing to their assigned servers",
      "packets": [
        { "id": "data_7", "label": "ID: 7", "target": "server_3", "formula": "7 % 4 = 3" },
        { "id": "data_12", "label": "ID: 12", "target": "server_0", "formula": "12 % 4 = 0" },
        { "id": "data_25", "label": "ID: 25", "target": "server_1", "formula": "25 % 4 = 1" }
      ],
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 4000,
        "stagger_ms": 1200
      }
    },
    "all_data_placed": {
      "elements_visible": ["server_0", "server_1", "server_2", "server_3", "placed_data"],
      "description": "All data items sitting at their assigned servers",
      "data_placement": {
        "server_0": ["ID: 12"],
        "server_1": ["ID: 25"],
        "server_2": [],
        "server_3": ["ID: 7"]
      }
    },
    "server_crash": {
      "elements_visible": ["server_0", "server_1", "server_2_crashed", "server_3"],
      "description": "Server 2 crashes with red flash and explosion effect",
      "crash_target": "server_2",
      "enter_animation": {
        "type": "crash_sequence",
        "duration_ms": 2000,
        "effects": ["red_flash", "shake", "fade_out"]
      }
    },
    "show_remapping": {
      "elements_visible": ["server_0", "server_1", "server_3", "remap_arrows"],
      "description": "Show data remapping with new formulas (mod 3 instead of mod 4)",
      "remaps": [
        { "id": "data_7", "from": "server_3", "to": "server_1", "old_formula": "7 % 4 = 3", "new_formula": "7 % 3 = 1" },
        { "id": "data_12", "from": "server_0", "to": "server_0", "old_formula": "12 % 4 = 0", "new_formula": "12 % 3 = 0", "stayed": true },
        { "id": "data_25", "from": "server_1", "to": "server_1", "old_formula": "25 % 4 = 1", "new_formula": "25 % 3 = 1", "stayed": true }
      ],
      "enter_animation": {
        "type": "remap_sequence",
        "duration_ms": 3000,
        "stagger_ms": 800
      }
    },
    "show_cascade": {
      "elements_visible": ["server_0", "server_1", "server_3", "cascade_indicator"],
      "description": "Show the 75% data movement with a big indicator",
      "annotation": "~75% of ALL data must move!",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "teaser_ring": {
      "elements_visible": ["ring_outline"],
      "description": "Fade everything out and show a faint hash ring outline as a teaser",
      "enter_animation": {
        "type": "morph_to_ring",
        "duration_ms": 2000
      }
    }
  }
}
