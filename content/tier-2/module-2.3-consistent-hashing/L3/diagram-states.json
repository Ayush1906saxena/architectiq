{
  "diagram": "virtual-nodes",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "uneven_ring": {
      "elements_visible": ["hash_ring", "server_a_large_arc", "server_b_tiny_arc", "server_c_medium_arc"],
      "description": "Three servers on ring with wildly uneven ownership arcs",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "virtual_nodes_intro": {
      "elements_visible": ["hash_ring", "server_a_node", "server_a_vnodes_preview"],
      "description": "Server A splitting into multiple virtual node points on the ring",
      "enter_animation": {
        "type": "multiply_animation",
        "duration_ms": 2000
      }
    },
    "vnodes_placed": {
      "elements_visible": ["hash_ring", "a_vnodes", "b_vnodes", "c_vnodes", "vnode_labels"],
      "description": "All three servers with multiple virtual nodes spread around the ring",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 200
      }
    },
    "even_distribution": {
      "elements_visible": ["hash_ring", "all_vnodes", "convergence_chart"],
      "description": "Chart showing distribution evenness improving as virtual node count increases",
      "enter_animation": {
        "type": "draw_chart",
        "duration_ms": 2000
      }
    },
    "heterogeneous_servers": {
      "elements_visible": ["big_server_icon", "small_server_icon", "capacity_labels", "vnode_count_labels"],
      "description": "Two servers of different sizes with different virtual node counts",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "proportional_vnodes": {
      "elements_visible": ["hash_ring", "big_server_300_vnodes", "small_server_50_vnodes", "proportional_arcs"],
      "description": "Ring showing big server owning 6x more arc space via more virtual nodes",
      "enter_animation": {
        "type": "highlight_arcs",
        "duration_ms": 1500
      }
    },
    "vnode_add_server": {
      "elements_visible": ["hash_ring", "existing_vnodes", "new_server_vnodes", "distributed_migration_arrows"],
      "description": "New server's virtual nodes stealing tiny slices from multiple existing servers",
      "enter_animation": {
        "type": "insert_distributed",
        "duration_ms": 2500
      }
    },
    "tradeoff_view": {
      "elements_visible": ["metadata_size_bar", "data_size_bar", "comparison_label"],
      "description": "Bar chart showing routing table metadata is tiny compared to actual data",
      "enter_animation": {
        "type": "bar_chart_grow",
        "duration_ms": 1500
      }
    },
    "real_systems": {
      "elements_visible": ["cassandra_config", "dynamo_config", "vnode_counts"],
      "description": "Real-world virtual node configurations from Cassandra and DynamoDB",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}