{
  "diagram": "crdts",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "g_counter": {
      "elements_visible": ["replica_a", "replica_b", "replica_c", "slot_values", "sum_display"],
      "description": "Three replicas each with their own counter slot, sum shown at bottom",
      "slots": { "replica_a": 5, "replica_b": 3, "replica_c": 7 },
      "enter_animation": {
        "type": "increment_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "pn_counter": {
      "elements_visible": ["positive_counter", "negative_counter", "net_value", "merge_arrows"],
      "description": "Two G-Counters side by side: increments and decrements, net value shown",
      "enter_animation": {
        "type": "dual_counter_reveal",
        "duration_ms": 2000
      }
    },
    "lww_register": {
      "elements_visible": ["replica_a_write", "replica_b_write", "timestamp_comparison", "winner_highlight", "lost_update_warning"],
      "description": "Two concurrent writes with timestamps, higher timestamp wins, lost update flagged",
      "enter_animation": {
        "type": "conflict_resolution",
        "duration_ms": 2000
      }
    },
    "or_set": {
      "elements_visible": ["replica_a_adds", "replica_b_removes", "unique_tags", "merge_result"],
      "description": "Add on replica A with unique tag, concurrent remove on B, add wins after merge",
      "enter_animation": {
        "type": "tag_merge_sequence",
        "duration_ms": 2500
      }
    },
    "riak_implementation": {
      "elements_visible": ["riak_cluster", "crdt_types_list", "write_any_node", "auto_merge"],
      "description": "Riak cluster with CRDT type icons: counter, set, map, flag",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "redis_crdt": {
      "elements_visible": ["tokyo_cluster", "virginia_cluster", "bidirectional_sync", "convergence_indicator"],
      "description": "Redis Enterprise active-active with cross-region CRDT merge",
      "enter_animation": {
        "type": "cross_region_flow",
        "duration_ms": 2000
      }
    },
    "limitations": {
      "elements_visible": ["no_invariants_card", "no_transactions_card", "metadata_growth_card"],
      "description": "Three limitation cards: no global invariants, no cross-CRDT transactions, metadata bloat",
      "enter_animation": {
        "type": "card_flip",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "decision_guide": {
      "elements_visible": ["good_for_list", "bad_for_list", "divider"],
      "description": "Two-column guide: good use cases vs bad use cases for CRDTs",
      "enter_animation": {
        "type": "columns_reveal",
        "duration_ms": 1500
      }
    },
    "summary": {
      "elements_visible": ["convergence_diagram", "crdt_family_icons"],
      "description": "All CRDT types converging to same state from different paths",
      "enter_animation": {
        "type": "converge_animation",
        "duration_ms": 2000
      }
    }
  }
}