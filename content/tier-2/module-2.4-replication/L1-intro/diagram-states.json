{
  "diagram": "replication",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "single_db": {
      "elements_visible": ["database", "app_arrows"],
      "description": "Single database with application arrows pointing to it",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "leader_appears": {
      "elements_visible": ["leader_db", "leader_label"],
      "description": "The single database is now labeled as the leader",
      "enter_animation": {
        "type": "label_appear",
        "duration_ms": 800
      }
    },
    "followers_appear": {
      "elements_visible": ["leader_db", "leader_label", "follower_1", "follower_2", "replication_arrows"],
      "description": "Two follower databases appear with replication arrows from the leader",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "write_to_leader": {
      "elements_visible": ["leader_db", "leader_label", "follower_1", "follower_2", "write_packet"],
      "description": "A write request packet flows to the leader",
      "enter_animation": {
        "type": "packet_flow",
        "duration_ms": 1500
      }
    },
    "replication_flow": {
      "elements_visible": ["leader_db", "leader_label", "follower_1", "follower_2", "wal_stream", "read_arrows"],
      "description": "WAL stream flows from leader to followers; read arrows point to followers",
      "enter_animation": {
        "type": "stream_flow",
        "duration_ms": 2500
      }
    },
    "replication_lag": {
      "elements_visible": ["leader_db", "leader_label", "follower_1", "follower_2_lagging", "lag_indicator"],
      "description": "Follower 2 shows a lag indicator and stale data warning",
      "enter_animation": {
        "type": "lag_highlight",
        "duration_ms": 1500,
        "effects": ["yellow_glow", "clock_icon"]
      }
    },
    "leader_crash": {
      "elements_visible": ["leader_db_crashed", "follower_1", "follower_2", "broken_arrows"],
      "description": "Leader crashes with red flash; replication arrows break",
      "crash_target": "leader_db",
      "enter_animation": {
        "type": "crash_sequence",
        "duration_ms": 2000,
        "effects": ["red_flash", "shake", "fade_out"]
      }
    },
    "follower_promotion": {
      "elements_visible": ["new_leader_db", "new_leader_label", "follower_2", "new_replication_arrows", "crown"],
      "description": "Follower 1 is promoted to leader with a crown icon; new replication arrows form",
      "enter_animation": {
        "type": "promotion_sequence",
        "duration_ms": 2500,
        "effects": ["crown_drop", "label_change", "arrows_reconnect"]
      }
    }
  }
}