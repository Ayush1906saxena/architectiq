{
  "diagram": "anti-entropy",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "merkle_tree": {
      "elements_visible": ["tree_root", "tree_level_1", "tree_level_2", "leaf_hashes", "data_ranges"],
      "description": "Binary Merkle tree with hash values at each level, data ranges at leaves",
      "enter_animation": {
        "type": "tree_build_bottom_up",
        "duration_ms": 3000,
        "stagger_ms": 400
      }
    },
    "merkle_comparison": {
      "elements_visible": ["tree_replica_a", "tree_replica_b", "root_comparison", "diff_highlight_path"],
      "description": "Two Merkle trees side by side, walking down to find divergent range",
      "enter_animation": {
        "type": "comparison_walk",
        "duration_ms": 2500
      }
    },
    "read_repair": {
      "elements_visible": ["coordinator", "replica_1", "replica_2", "replica_3", "read_arrows", "stale_indicator", "repair_arrow"],
      "description": "Coordinator reads from three replicas, detects stale one, sends repair",
      "enter_animation": {
        "type": "read_compare_repair",
        "duration_ms": 2500
      }
    },
    "hinted_handoff": {
      "elements_visible": ["coordinator", "target_node_down", "hint_storage", "recovery_replay"],
      "description": "Write target is down, coordinator stores hint, replays when target recovers",
      "enter_animation": {
        "type": "store_then_replay",
        "duration_ms": 2500
      }
    },
    "sloppy_quorum": {
      "elements_visible": ["original_replicas", "down_replica", "substitute_node", "temporary_arrow"],
      "description": "Substitute node accepts write for downed replica temporarily",
      "enter_animation": {
        "type": "substitute_flow",
        "duration_ms": 1500
      }
    },
    "cassandra_repair": {
      "elements_visible": ["nodetool_command", "merkle_build_phase", "compare_phase", "stream_phase", "progress_bar"],
      "description": "Cassandra repair process: build trees, compare, stream differences",
      "enter_animation": {
        "type": "phase_sequence",
        "duration_ms": 3000,
        "stagger_ms": 800
      }
    },
    "zombie_data": {
      "elements_visible": ["tombstone", "gc_grace_timer", "tombstone_removed", "data_resurrects"],
      "description": "Tombstone expires before repair runs, deleted data comes back as zombie",
      "enter_animation": {
        "type": "zombie_sequence",
        "duration_ms": 2500,
        "effects": ["timer_tick", "tombstone_fade", "data_glow"]
      }
    },
    "tradeoff_matrix": {
      "elements_visible": ["matrix_grid", "row_read_repair", "row_hinted", "row_merkle", "col_cpu", "col_network", "col_latency"],
      "description": "Cost matrix for each anti-entropy mechanism across resource dimensions",
      "enter_animation": {
        "type": "grid_fill",
        "duration_ms": 1500
      }
    },
    "layered_defense": {
      "elements_visible": ["layer_read_repair", "layer_hinted_handoff", "layer_full_repair", "convergence_arrow"],
      "description": "Three defense layers stacked: read repair, hinted handoff, full Merkle repair",
      "enter_animation": {
        "type": "layer_stack",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    }
  }
}