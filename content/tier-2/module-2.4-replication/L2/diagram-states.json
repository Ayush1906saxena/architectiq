{
  "diagram": "sync-async-replication",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "sync_flow": {
      "elements_visible": ["client", "leader", "replica_1", "replica_2", "sync_arrows", "wait_indicator"],
      "description": "Client writes to leader, leader waits for all replicas to ACK before responding",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "sync_crash_safe": {
      "elements_visible": ["leader_crashed", "replica_1_with_data", "replica_2_with_data", "checkmark"],
      "description": "Leader crashes but data survives on both replicas",
      "enter_animation": {
        "type": "crash_sequence",
        "duration_ms": 2000,
        "effects": ["red_flash", "green_checkmarks"]
      }
    },
    "sync_latency": {
      "elements_visible": ["client", "leader", "replica_local", "replica_remote", "latency_bars"],
      "description": "Latency bars showing remote replica adding 200ms to every write",
      "enter_animation": {
        "type": "bar_chart_grow",
        "duration_ms": 1500
      }
    },
    "sync_blocked": {
      "elements_visible": ["client", "leader", "replica_1", "replica_2_down", "blocked_indicator"],
      "description": "One replica down, writes completely blocked with spinning indicator",
      "enter_animation": {
        "type": "crash_and_block",
        "duration_ms": 1500
      }
    },
    "async_flow": {
      "elements_visible": ["client", "leader", "replica_1", "replica_2", "fast_ack_arrow", "background_arrows"],
      "description": "Leader ACKs client immediately, replicates in background",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 2000
      }
    },
    "async_performance": {
      "elements_visible": ["client", "leader", "fast_latency_counter"],
      "description": "Single-digit millisecond write latency displayed",
      "enter_animation": {
        "type": "counter_animation",
        "duration_ms": 1000
      }
    },
    "async_data_loss": {
      "elements_visible": ["leader_crashed", "replica_stale", "lost_writes_indicator", "replication_lag_label"],
      "description": "Leader crashes with unreplicated writes, data is lost",
      "enter_animation": {
        "type": "crash_sequence",
        "duration_ms": 2000,
        "effects": ["red_flash", "data_vanish"]
      }
    },
    "semi_sync_flow": {
      "elements_visible": ["client", "leader", "replica_1_sync", "replica_2_async", "mixed_arrows"],
      "description": "Leader waits for one replica ACK, then ACKs client while second replica catches up",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 2500
      }
    },
    "real_world_configs": {
      "elements_visible": ["mysql_config", "postgres_config", "config_labels"],
      "description": "MySQL and PostgreSQL semi-sync configuration snippets",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "spectrum_view": {
      "elements_visible": ["spectrum_bar", "sync_end", "async_end", "semi_sync_marker", "tradeoff_labels"],
      "description": "Horizontal spectrum from fully synchronous to fully asynchronous with trade-off labels",
      "enter_animation": {
        "type": "draw_spectrum",
        "duration_ms": 1500
      }
    }
  }
}