{
  "diagram": "url-journey",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "browser_types_url": {
      "elements_visible": ["browser_window", "url_bar"],
      "description": "A browser window with a URL being typed into the address bar",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "dns_lookup": {
      "elements_visible": ["browser_window", "dns_resolver", "dns_query_arrow", "ip_address_label"],
      "description": "Browser sends domain name to DNS resolver, gets back an IP address",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 2500,
        "stagger_ms": 800
      }
    },
    "tcp_handshake": {
      "elements_visible": ["browser_window", "server_box", "syn_arrow", "syn_ack_arrow", "ack_arrow"],
      "description": "Three-way handshake: SYN, SYN-ACK, ACK arrows between browser and server",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 800
      }
    },
    "http_request": {
      "elements_visible": ["browser_window", "server_box", "http_get_arrow", "request_headers"],
      "description": "HTTP GET request flowing from browser to server",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 1500
      }
    },
    "server_processes": {
      "elements_visible": ["browser_window", "server_box", "processing_gears", "database_icon"],
      "description": "Server processing the request with gear animation and database lookup",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "response_returns": {
      "elements_visible": ["browser_window", "server_box", "response_arrow", "status_code_200", "html_payload"],
      "description": "HTTP response with status 200 and HTML payload flowing back to browser",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 2000
      }
    },
    "page_renders": {
      "elements_visible": ["browser_window", "rendered_page", "dom_tree", "full_flow_timeline"],
      "description": "Browser renders the page; a timeline shows the full flow from DNS to paint",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    }
  }
}
