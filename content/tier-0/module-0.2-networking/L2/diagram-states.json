{
  "diagram": "tcp-protocol",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "two_hosts": {
      "elements_visible": ["client_host", "server_host"],
      "description": "Client and server appear on opposite sides",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "three_way_handshake": {
      "elements_visible": ["client_host", "server_host", "syn_arrow", "synack_arrow", "ack_arrow"],
      "description": "Animated SYN, SYN-ACK, ACK arrows between client and server",
      "enter_animation": {
        "type": "arrow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 800
      }
    },
    "handshake_latency": {
      "elements_visible": ["client_host", "server_host", "syn_arrow", "synack_arrow", "ack_arrow", "rtt_label"],
      "description": "Highlight the round-trip time cost of the handshake",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 800
      }
    },
    "sequence_numbers": {
      "elements_visible": ["client_host", "server_host", "numbered_packets"],
      "description": "Show numbered byte packets flowing from client to server",
      "packets": [
        { "id": "pkt_1", "label": "Seq: 1-100", "index": 0 },
        { "id": "pkt_2", "label": "Seq: 101-200", "index": 1 },
        { "id": "pkt_3", "label": "Seq: 201-300", "index": 2 }
      ],
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "ack_flow": {
      "elements_visible": ["client_host", "server_host", "data_packets", "ack_packets", "retransmit_indicator"],
      "description": "Show data flowing right and ACKs flowing left, with a retransmit",
      "enter_animation": {
        "type": "bidirectional_flow",
        "duration_ms": 4000,
        "stagger_ms": 500
      }
    },
    "retransmission": {
      "elements_visible": ["client_host", "server_host", "lost_packet", "timeout_timer", "retransmit_packet"],
      "description": "A packet is lost, timer expires, packet is retransmitted",
      "enter_animation": {
        "type": "retransmit_sequence",
        "duration_ms": 3500
      }
    },
    "sliding_window": {
      "elements_visible": ["client_host", "server_host", "window_frame", "buffer_indicator"],
      "description": "Sliding window showing receiver buffer and send window",
      "window_size": "16KB",
      "enter_animation": {
        "type": "slide_animation",
        "duration_ms": 3000
      }
    },
    "congestion_control": {
      "elements_visible": ["client_host", "server_host", "network_pipe", "congestion_indicator"],
      "description": "Network pipe showing congestion buildup and TCP backing off",
      "enter_animation": {
        "type": "congestion_sequence",
        "duration_ms": 3000
      }
    },
    "slow_start_graph": {
      "elements_visible": ["sawtooth_graph", "cwnd_label", "threshold_line"],
      "description": "Graph showing TCP congestion window over time — exponential then linear",
      "enter_animation": {
        "type": "draw_graph",
        "duration_ms": 3000
      }
    },
    "connection_teardown": {
      "elements_visible": ["client_host", "server_host", "fin_1", "ack_1", "fin_2", "ack_2"],
      "description": "Four-way FIN-ACK teardown sequence",
      "enter_animation": {
        "type": "arrow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "tcp_summary": {
      "elements_visible": ["summary_card"],
      "description": "Summary card showing TCP's key mechanisms",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}