{
  "diagram": "client-server",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "client_appears": {
      "elements_visible": ["client_box", "client_label"],
      "description": "A client box (browser/phone icon) appears on the left side",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "server_appears": {
      "elements_visible": ["client_box", "client_label", "server_box", "server_label"],
      "description": "A server box appears on the right side opposite the client",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "request_flow": {
      "elements_visible": ["client_box", "server_box", "request_arrow", "request_label"],
      "description": "An arrow from client to server labeled with a request",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 2000
      }
    },
    "response_flow": {
      "elements_visible": ["client_box", "server_box", "request_arrow", "response_arrow", "response_label"],
      "description": "A return arrow from server to client carrying the response",
      "enter_animation": {
        "type": "packet_flow_sequence",
        "duration_ms": 2000
      }
    },
    "api_endpoint": {
      "elements_visible": ["client_box", "server_box", "api_contract", "endpoint_list"],
      "description": "An API contract panel appears between client and server showing endpoint URLs and HTTP methods",
      "endpoint_examples": [
        { "method": "GET", "path": "/users/42" },
        { "method": "POST", "path": "/posts" },
        { "method": "DELETE", "path": "/comments/7" }
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "json_payload": {
      "elements_visible": ["client_box", "server_box", "json_example", "json_highlight"],
      "description": "A JSON response object expands showing key-value pairs",
      "json_example": {
        "id": 42,
        "name": "Alice",
        "email": "alice@example.com"
      },
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "status_codes": {
      "elements_visible": ["client_box", "server_box", "status_200", "status_404", "status_500", "status_legend"],
      "description": "Status codes appear with color coding: green for 2xx, yellow for 4xx, red for 5xx",
      "status_entries": [
        { "code": 200, "label": "OK", "color": "green" },
        { "code": 201, "label": "Created", "color": "green" },
        { "code": 400, "label": "Bad Request", "color": "yellow" },
        { "code": 404, "label": "Not Found", "color": "yellow" },
        { "code": 500, "label": "Server Error", "color": "red" }
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 400
      }
    }
  }
}
