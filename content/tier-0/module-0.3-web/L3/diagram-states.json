{
  "diagram": "auth-and-authz",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "session_auth": {
      "elements_visible": ["client", "server", "session_store", "cookie_arrow"],
      "description": "Client sends credentials, server creates session, returns cookie",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 3000,
        "stagger_ms": 600
      }
    },
    "session_scaling": {
      "elements_visible": ["client", "load_balancer", "server_1", "server_2", "server_3", "question_marks"],
      "description": "Multiple servers behind load balancer — which has the session?",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 2000
      }
    },
    "token_auth": {
      "elements_visible": ["client", "server", "token_arrow", "verify_step"],
      "description": "Server issues signed token, client sends it back, server verifies signature",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "jwt_structure": {
      "elements_visible": ["header_section", "payload_section", "signature_section", "dot_separators"],
      "description": "JWT broken into three color-coded sections: header, payload, signature",
      "enter_animation": {
        "type": "expand_reveal",
        "duration_ms": 2000
      }
    },
    "oauth_concept": {
      "elements_visible": ["user", "app", "resource_server", "delegation_arrow"],
      "description": "User grants app access to resources without sharing credentials",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "oauth_auth_code": {
      "elements_visible": ["user", "app", "auth_server", "resource_server", "code_flow_arrows"],
      "description": "Authorization code flow: redirect, login, code, token exchange",
      "enter_animation": {
        "type": "arrow_sequence",
        "duration_ms": 4000,
        "stagger_ms": 800
      }
    },
    "oidc_layer": {
      "elements_visible": ["oauth_layer", "oidc_layer", "id_token"],
      "description": "OIDC as a layer on top of OAuth, adding ID token",
      "enter_animation": {
        "type": "layer_stack",
        "duration_ms": 2000
      }
    },
    "refresh_flow": {
      "elements_visible": ["access_token", "refresh_token", "expiry_timeline", "refresh_cycle"],
      "description": "Access token expires, refresh token obtains new access token",
      "enter_animation": {
        "type": "timeline_draw",
        "duration_ms": 2500
      }
    },
    "token_rotation": {
      "elements_visible": ["old_refresh", "new_refresh", "invalidation_indicator"],
      "description": "Refresh token rotation: old token invalidated, new one issued",
      "enter_animation": {
        "type": "rotation_sequence",
        "duration_ms": 2000
      }
    },
    "auth_summary": {
      "elements_visible": ["summary_card"],
      "description": "Summary card comparing sessions, JWTs, OAuth, and OIDC",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}