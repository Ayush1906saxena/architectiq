{
  "diagram": "computer-basics",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "cpu_cycle_visible": {
      "elements_visible": ["cpu_chip", "fetch_arrow", "decode_arrow", "execute_arrow"],
      "description": "CPU chip with the fetch-decode-execute cycle shown as a circular flow",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "ram_visible": {
      "elements_visible": ["cpu_chip", "ram_module"],
      "description": "RAM module appears next to the CPU with a fast bidirectional arrow",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 800
      }
    },
    "ram_and_disk": {
      "elements_visible": ["cpu_chip", "ram_module", "disk_drive"],
      "description": "Disk drive appears below RAM with a slower, thinner connection arrow",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 800
      }
    },
    "speed_ladder": {
      "elements_visible": ["cpu_chip", "ram_module", "disk_drive", "latency_labels"],
      "description": "Latency comparison ladder showing CPU registers, RAM, SSD, HDD access times",
      "latency_data": [
        { "label": "CPU register", "time": "< 1 ns" },
        { "label": "RAM", "time": "~100 ns" },
        { "label": "SSD", "time": "~100 us" },
        { "label": "HDD", "time": "~10 ms" }
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "processes_visible": {
      "elements_visible": ["process_a", "process_b", "process_c", "memory_boundaries"],
      "description": "Three process boxes each with their own isolated memory space",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "threads_visible": {
      "elements_visible": ["process_a", "thread_1", "thread_2", "thread_3", "shared_memory"],
      "description": "Multiple threads inside one process sharing the same memory region",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "os_layer_visible": {
      "elements_visible": ["os_kernel", "process_a", "process_b", "cpu_chip", "ram_module", "disk_drive"],
      "description": "OS kernel layer sitting between applications and hardware, with arrows showing orchestration",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "context_switch": {
      "elements_visible": ["cpu_chip", "process_a_state", "process_b_state", "switch_arrow"],
      "description": "CPU switching between process A and process B, saving and restoring state",
      "enter_animation": {
        "type": "swap_animation",
        "duration_ms": 1500
      }
    },
    "full_picture": {
      "elements_visible": ["cpu_chip", "ram_module", "disk_drive", "os_kernel", "process_a", "process_b", "threads"],
      "description": "Complete architecture view: CPU, RAM, disk, OS kernel, processes, and threads",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}
