{
  "diagram": "cpu-execution",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "show_fde_cycle": {
      "elements_visible": ["fetch_box", "decode_box", "execute_box", "cycle_arrows"],
      "description": "Three boxes in a circle showing fetch-decode-execute with arrows connecting them",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 500
      }
    },
    "show_fetch_stage": {
      "elements_visible": ["fetch_box_highlighted", "program_counter", "memory_block", "instruction_register", "fetch_arrow"],
      "description": "Highlight fetch stage showing program counter pointing to memory, instruction flowing to register",
      "enter_animation": {
        "type": "flow_animation",
        "duration_ms": 1500
      }
    },
    "show_decode_execute": {
      "elements_visible": ["fetch_box", "decode_box_highlighted", "execute_box_highlighted", "control_unit", "alu"],
      "description": "Highlight decode and execute stages with control unit and ALU visible",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 600
      }
    },
    "show_clock_speed": {
      "elements_visible": ["fetch_box", "decode_box", "execute_box", "clock_signal", "ghz_label"],
      "description": "Show clock signal pulsing at 3 GHz with label",
      "enter_animation": {
        "type": "pulse",
        "duration_ms": 2000,
        "repeat": 3
      }
    },
    "show_idle_stages": {
      "elements_visible": ["fetch_box_dim", "decode_box_dim", "execute_box_active", "instruction_1"],
      "description": "Show one instruction executing while fetch and decode are dimmed and idle",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 800
      }
    },
    "show_pipeline": {
      "elements_visible": ["pipeline_grid", "instruction_1", "instruction_2", "instruction_3", "pipeline_arrows"],
      "description": "Pipeline diagram with three instructions overlapping in fetch/decode/execute stages",
      "pipeline_slots": [
        {"cycle": 1, "fetch": "I1", "decode": "-", "execute": "-"},
        {"cycle": 2, "fetch": "I2", "decode": "I1", "execute": "-"},
        {"cycle": 3, "fetch": "I3", "decode": "I2", "execute": "I1"}
      ],
      "enter_animation": {
        "type": "slide_in_sequence",
        "duration_ms": 3000,
        "stagger_ms": 800
      }
    },
    "show_pipeline_comparison": {
      "elements_visible": ["no_pipeline_timeline", "pipeline_timeline", "speedup_label"],
      "description": "Side-by-side comparison showing 9 cycles without pipelining vs 5 with pipelining",
      "annotation": "3x throughput improvement",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "show_branch_stall": {
      "elements_visible": ["pipeline_grid", "branch_instruction", "stall_bubbles", "question_mark"],
      "description": "Pipeline with stall bubbles where a branch instruction causes uncertainty",
      "enter_animation": {
        "type": "stall_animation",
        "duration_ms": 2000
      }
    },
    "show_branch_prediction": {
      "elements_visible": ["pipeline_grid", "predictor_box", "history_table", "success_checkmark"],
      "description": "Branch predictor with history table showing 97% accuracy",
      "annotation": "97%+ prediction accuracy",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "show_pipeline_flush": {
      "elements_visible": ["pipeline_grid", "flushed_instructions", "penalty_label"],
      "description": "Pipeline flush on misprediction, showing wasted work being discarded",
      "enter_animation": {
        "type": "flush_sequence",
        "duration_ms": 1500,
        "effects": ["red_highlight", "discard"]
      }
    },
    "show_full_pipeline_summary": {
      "elements_visible": ["fde_cycle", "pipeline_grid", "predictor_box", "summary_labels"],
      "description": "Complete summary showing FDE cycle, pipelining, and branch prediction together",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}