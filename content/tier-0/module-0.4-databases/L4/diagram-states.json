{
  "diagram": "transactions-acid",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "atomicity": {
      "elements_visible": ["debit_step", "credit_step", "rollback_indicator", "all_or_nothing_label"],
      "description": "Two-step transaction with rollback arrow showing all-or-nothing",
      "enter_animation": {
        "type": "flow_sequence",
        "duration_ms": 2500,
        "stagger_ms": 600
      }
    },
    "consistency": {
      "elements_visible": ["state_before", "state_after", "constraint_checks", "valid_arrow"],
      "description": "Database moving from valid state to valid state through constraints",
      "enter_animation": {
        "type": "morph_transition",
        "duration_ms": 2000
      }
    },
    "isolation_levels": {
      "elements_visible": ["level_spectrum", "read_uncommitted", "read_committed", "repeatable_read", "serializable"],
      "description": "Spectrum from least strict to most strict isolation levels",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "dirty_read": {
      "elements_visible": ["txn_a", "txn_b", "uncommitted_data", "rollback_indicator"],
      "description": "Transaction B reads uncommitted data from Transaction A that later rolls back",
      "enter_animation": {
        "type": "timeline_draw",
        "duration_ms": 3000
      }
    },
    "read_committed": {
      "elements_visible": ["txn_a", "txn_b", "first_read", "commit", "second_read", "different_values"],
      "description": "Two reads of same row return different values after another transaction commits",
      "enter_animation": {
        "type": "timeline_draw",
        "duration_ms": 3000
      }
    },
    "repeatable_read": {
      "elements_visible": ["txn_a", "txn_b", "phantom_row", "range_query"],
      "description": "A new row appears in a range query between two executions",
      "enter_animation": {
        "type": "timeline_draw",
        "duration_ms": 3000
      }
    },
    "serializable": {
      "elements_visible": ["txn_queue", "serial_execution_arrows", "lock_indicators"],
      "description": "Transactions executing as if serial, with lock indicators",
      "enter_animation": {
        "type": "sequential_flow",
        "duration_ms": 2500
      }
    },
    "deadlock": {
      "elements_visible": ["txn_a", "txn_b", "lock_a", "lock_b", "cycle_arrow", "victim_label"],
      "description": "Circular dependency between two transactions, one killed as victim",
      "enter_animation": {
        "type": "cycle_draw",
        "duration_ms": 2500
      }
    },
    "mvcc": {
      "elements_visible": ["row_versions", "reader_snapshot", "writer_new_version", "version_chain"],
      "description": "Multiple row versions with reader seeing snapshot and writer creating new version",
      "enter_animation": {
        "type": "version_chain_reveal",
        "duration_ms": 3000
      }
    },
    "acid_summary": {
      "elements_visible": ["summary_card"],
      "description": "Summary card with ACID properties and isolation level tradeoffs",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
  }
}