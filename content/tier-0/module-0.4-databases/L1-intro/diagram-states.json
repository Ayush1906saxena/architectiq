{
  "diagram": "databases-101",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "files_on_disk": {
      "elements_visible": ["file_users_txt", "file_orders_txt", "disk_icon"],
      "description": "Two text files (users.txt, orders.txt) sitting on a disk icon",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 1500,
        "stagger_ms": 400
      }
    },
    "problems_with_files": {
      "elements_visible": ["file_users_txt", "file_orders_txt", "conflict_icon", "slow_search_icon"],
      "description": "Conflict arrows showing two writers and a magnifying glass showing slow search",
      "problems": [
        "Concurrent writes corrupt data",
        "No efficient search — full scan required",
        "No data validation or constraints"
      ],
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    },
    "database_appears": {
      "elements_visible": ["database_cylinder", "database_label"],
      "description": "A database cylinder icon replaces the flat files",
      "enter_animation": {
        "type": "morph_transition",
        "duration_ms": 1500
      }
    },
    "table_structure": {
      "elements_visible": ["database_cylinder", "users_table", "column_headers", "sample_rows"],
      "description": "A table with columns (id, name, email) and sample rows of data",
      "table": {
        "name": "users",
        "columns": ["id", "name", "email"],
        "rows": [
          [1, "Alice", "alice@example.com"],
          [2, "Bob", "bob@example.com"],
          [42, "Charlie", "charlie@example.com"]
        ]
      },
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 300
      }
    },
    "sql_query": {
      "elements_visible": ["database_cylinder", "users_table", "sql_statement", "result_highlight"],
      "description": "A SQL query 'SELECT name FROM users WHERE id = 42' with the matching row highlighted",
      "query": "SELECT name FROM users WHERE id = 42",
      "result": "Charlie",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "index_lookup": {
      "elements_visible": ["database_cylinder", "btree_diagram", "search_path_highlight", "card_catalog_analogy"],
      "description": "A B-tree index diagram showing how a lookup traverses from root to leaf in O(log n)",
      "btree_levels": ["root", "internal_nodes", "leaf_nodes"],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 600
      }
    },
    "acid_properties": {
      "elements_visible": ["acid_a", "acid_c", "acid_i", "acid_d", "acid_descriptions"],
      "description": "Four panels for ACID: Atomicity, Consistency, Isolation, Durability with brief descriptions",
      "properties": [
        { "letter": "A", "name": "Atomicity", "summary": "All or nothing" },
        { "letter": "C", "name": "Consistency", "summary": "Rules always hold" },
        { "letter": "I", "name": "Isolation", "summary": "No interference" },
        { "letter": "D", "name": "Durability", "summary": "Survives crashes" }
      ],
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    }
  }
}
