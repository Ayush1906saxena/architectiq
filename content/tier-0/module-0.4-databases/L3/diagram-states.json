{
  "diagram": "nosql-overview",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "document_store": {
      "elements_visible": ["mongodb_icon", "document_examples", "flexible_schema_label"],
      "description": "MongoDB logo with sample JSON documents of varying structure",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "key_value_store": {
      "elements_visible": ["redis_icon", "key_value_pairs", "hash_map_visual"],
      "description": "Redis logo with key-value pairs and hash map visualization",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    },
    "columnar_store": {
      "elements_visible": ["cassandra_icon", "column_family_visual", "row_vs_column_comparison"],
      "description": "Row-oriented vs column-oriented storage side by side",
      "enter_animation": {
        "type": "split_reveal",
        "duration_ms": 2000
      }
    },
    "graph_store": {
      "elements_visible": ["neo4j_icon", "nodes", "edges", "traversal_path"],
      "description": "Graph with nodes and edges, traversal path highlighted",
      "enter_animation": {
        "type": "graph_draw",
        "duration_ms": 2500
      }
    },
    "four_types_grid": {
      "elements_visible": ["document_card", "kv_card", "columnar_card", "graph_card"],
      "description": "Four quadrant grid showing all NoSQL types with use cases",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2000,
        "stagger_ms": 400
      }
    },
    "schema_tradeoff": {
      "elements_visible": ["flexibility_scale", "safety_scale", "balance_indicator"],
      "description": "Scale showing flexibility vs data integrity tradeoff",
      "enter_animation": {
        "type": "scale_balance",
        "duration_ms": 2000
      }
    },
    "scaling_comparison": {
      "elements_visible": ["vertical_scaling", "horizontal_scaling", "comparison_labels"],
      "description": "Vertical scaling (bigger machine) vs horizontal scaling (more machines)",
      "enter_animation": {
        "type": "split_reveal",
        "duration_ms": 2000
      }
    },
    "cap_positioning": {
      "elements_visible": ["cap_triangle", "cassandra_position", "mongodb_position", "labels"],
      "description": "CAP theorem triangle with databases positioned on it",
      "enter_animation": {
        "type": "triangle_draw",
        "duration_ms": 2500
      }
    },
    "polyglot": {
      "elements_visible": ["app_layer", "sql_db", "redis_cache", "elasticsearch", "connection_lines"],
      "description": "Application using multiple database types simultaneously",
      "enter_animation": {
        "type": "architecture_reveal",
        "duration_ms": 2500
      }
    },
    "nosql_summary": {
      "elements_visible": ["summary_card"],
      "description": "Summary card with NoSQL types and when to use each",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1000
      }
    }
