{
  "diagram": "db-internals-btree-lsm",
  "initial_state": "empty",
  "states": {
    "empty": {
      "elements_visible": [],
      "description": "Nothing shown yet"
    },
    "disk_blocks": {
      "elements_visible": ["disk_platter", "block_grid", "block_size_label"],
      "description": "A disk with a grid of 4KB blocks, showing that one block is the minimum read unit",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "btree_structure": {
      "elements_visible": ["btree_root", "btree_internal_nodes", "btree_leaf_nodes", "level_labels"],
      "description": "A B-tree with root, internal nodes, and leaf nodes. Each node shows multiple keys. Level labels indicate depth",
      "enter_animation": {
        "type": "fade_in_sequence",
        "duration_ms": 2500,
        "stagger_ms": 500
      }
    },
    "btree_lookup": {
      "elements_visible": ["btree_root", "btree_internal_nodes", "btree_leaf_nodes", "lookup_path", "disk_read_counter"],
      "description": "A highlighted path from root to leaf showing the lookup traversal, with a counter showing disk reads",
      "enter_animation": {
        "type": "path_trace",
        "duration_ms": 2000,
        "stagger_ms": 600
      }
    },
    "btree_insert": {
      "elements_visible": ["btree_root", "btree_internal_nodes", "btree_leaf_nodes", "insert_key", "split_animation"],
      "description": "A key being inserted into a leaf node that overflows, splitting into two nodes with a key pushed up",
      "enter_animation": {
        "type": "step_sequence",
        "duration_ms": 3000,
        "steps": ["insert_into_leaf", "leaf_overflow", "split_and_push_up"]
      }
    },
    "lsm_memtable": {
      "elements_visible": ["memtable_tree", "ram_boundary", "write_arrow"],
      "description": "An in-memory balanced tree (memtable) inside a RAM boundary, with write operations flowing into it",
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1200
      }
    },
    "lsm_sstable": {
      "elements_visible": ["memtable_tree", "ram_boundary", "disk_boundary", "sstable_files", "flush_arrow", "read_path"],
      "description": "Memtable flushing to disk as SSTable files. Read path shows checking memtable first, then SSTables",
      "enter_animation": {
        "type": "step_sequence",
        "duration_ms": 2500,
        "steps": ["show_flush", "show_sstables", "show_read_path"]
      }
    },
    "lsm_compaction": {
      "elements_visible": ["memtable_tree", "sstable_files_before", "compaction_arrows", "sstable_files_after"],
      "description": "Multiple small SSTables being merged into fewer larger ones during compaction",
      "enter_animation": {
        "type": "merge_animation",
        "duration_ms": 2500
      }
    },
    "btree_vs_lsm": {
      "elements_visible": ["comparison_table"],
      "description": "Side-by-side comparison table: B-tree vs LSM tree across reads, writes, space, and amplification factors",
      "table": {
        "headers": ["Property", "B-Tree", "LSM Tree"],
        "rows": [
          ["Read Performance", "Excellent (O(log n))", "Good (check multiple SSTables)"],
          ["Write Performance", "Good (in-place update)", "Excellent (sequential I/O)"],
          ["Write Amplification", "Higher (page rewrites)", "Lower (append-only)"],
          ["Read Amplification", "Lower (single path)", "Higher (multiple SSTables)"],
          ["Space Amplification", "Lower (in-place)", "Higher (duplicates until compaction)"],
          ["Use Case", "Read-heavy (OLTP)", "Write-heavy (logging, time-series)"]
        ]
      },
      "enter_animation": {
        "type": "fade_in",
        "duration_ms": 1500
      }
    }
  }
}
